respond idle
  netfn 0x30
  cmd 0xa6
  times 1
  data @ime/status_idle.hex
end
respond prepare
  netfn 0x30
  cmd 0xa0
end
respond requested
  netfn 0x30
  cmd 0xa6
  times 1
  data @ime/status_requested.hex
end
respond open_area
  netfn 0x30
  cmd 0xa1
  match 01 00
end
respond progress
  netfn 0x30
  cmd 0xa6
  data @ime/status_progress.hex
end
respond rejected_write
  netfn 0x30
  cmd 0xa2
  match 00
  ccode 0xc1
end
