# A BMC that grants a reservation but rejects Clear SEL and Delete SEL Entry.

default_ccode 0xc1

respond get_device_id
  netfn 0x06
  cmd 0x01
  data 20 81 02 03 02 bf 57 01 00 01 00 00 00 00 00
end

respond get_sel_info
  netfn 0x0a
  cmd 0x40
  data 51 06 00 ff ff 00 e3 0b 5e 00 00 00 00 0a
end

respond get_sel_0000
  netfn 0x0a
  cmd 0x43
  match 00 00 00 00
  data 02 11 01 11 02 00 e3 0b 5e 20 00 04 01 30 01 51 a1 b1
end

respond get_sel_1102
  netfn 0x0a
  cmd 0x43
  match 00 00 02 11
  data 03 11 02 11 02 01 e3 0b 5e 20 00 04 02 31 01 52 a2 b2
end

respond get_sel_1103
  netfn 0x0a
  cmd 0x43
  match 00 00 03 11
  data 04 11 03 11 02 02 e3 0b 5e 20 00 04 04 32 01 07 a3 b3
end

respond get_sel_1104
  netfn 0x0a
  cmd 0x43
  match 00 00 04 11
  data 05 11 04 11 02 03 e3 0b 5e 20 00 04 07 33 6f 00 a4 b4
end

respond get_sel_1105
  netfn 0x0a
  cmd 0x43
  match 00 00 05 11
  data 06 11 05 11 02 04 e3 0b 5e 20 00 04 09 34 6f 00 a5 b5
end

respond get_sel_1106
  netfn 0x0a
  cmd 0x43
  match 00 00 06 11
  data ff ff 06 11 02 05 e3 0b 5e 20 00 04 12 35 6f 00 a6 b6
end

respond reserve_sel
  netfn 0x0a
  cmd 0x42
  # reservation ID ABCDh: both bytes non-zero and different
  data cd ab
end

respond clear_sel
  netfn 0x0a
  cmd 0x47
  ccode 0xc9
end

respond delete_sel
  netfn 0x0a
  cmd 0x46
  ccode 0xcb
end
