# One VITA 46.11 controller exercising every command the CLI can send.
default_ccode 0xc1

respond vita_properties
  netfn 0x2c
  cmd 0x00
  match 03
  data 03 11 10 00 01 fe 80
end

respond vita_addr_255
  netfn 0x2c
  cmd 0x40
  match 03 ff
  data 03 55 aa ff ff 0a 0f 00 7e
end

respond vita_addr_default
  netfn 0x2c
  cmd 0x40
  match 03 00
  data 03 41 82 ff 00 01 00
end

respond vita_ipmb_address
  netfn 0x2c
  cmd 0x40
  match 03
  data 03 41 82 ff 00 01 00
end

respond vita_control
  netfn 0x2c
  cmd 0x04
  data 03
end

respond vita_led_properties
  netfn 0x2c
  cmd 0x05
  data 03 0f fe
end

respond vita_led_capabilities
  netfn 0x2c
  cmd 0x06
  data 03 ff 01 02 03
end

respond vita_led_set
  netfn 0x2c
  cmd 0x07
  data 03
end

respond vita_led_state
  netfn 0x2c
  cmd 0x08
  data 03 01 ff 00 01
end

respond vita_policy_set
  netfn 0x2c
  cmd 0x0a
  data 03
end

respond vita_policy_get
  netfn 0x2c
  cmd 0x0b
  data 03 0d
end

respond vita_activation
  netfn 0x2c
  cmd 0x0c
  data 03
end
