default_ccode 0xc1
respond get_device_id
  netfn 0x06
  cmd 0x01
  data 20 81 02 03 02 b7 57 01 00 01 00 00 00 00 00
end
respond get_spd_info
  netfn 0x0a
  cmd 0x10
  match 01
  data 00 01 00
end
respond zero_read
  netfn 0x0a
  cmd 0x11
  match 01
  # Data count zero with no progress would loop forever in the C decoder.
  data 00
end
respond sdr_repo_info
  netfn 0x0a
  cmd 0x20
  data 51 01 00 ff ff 00 00 00 00 00 00 00 00 02
end
respond reserve_sdr_repo
  netfn 0x0a
  cmd 0x22
  data 01 00
end
respond get_sdr_first
  netfn 0x0a
  cmd 0x23
  match 01 00 00 00
  data ff ff
  partial 4 1 5
  blob @sdr/spd_locator.hex
end
respond get_sdr_0004
  netfn 0x0a
  cmd 0x23
  match 01 00 04 00
  data ff ff
  partial 4 1 5
  blob @sdr/spd_locator.hex
end
