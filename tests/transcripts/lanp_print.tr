# LAN channel with all printable IPv4 LAN settings and both optional tables.
default_ccode 0x80
respond medium
  netfn 0x06
  cmd 0x42
  data 01 04 01 84 f2 1b 00 00 00
end
respond in_progress
  netfn 0x0c
  cmd 0x02
  match 01 00
  data 11 00
end
respond auth_support
  netfn 0x0c
  cmd 0x02
  match 01 01
  data 11 17
end
respond auth_enable
  netfn 0x0c
  cmd 0x02
  match 01 02
  data 11 01 02 04 10 00
end
respond address
  netfn 0x0c
  cmd 0x02
  match 01 03
  data 11 c0 a8 01 0a
end
respond source
  netfn 0x0c
  cmd 0x02
  match 01 04
  data 11 02
end
respond mac
  netfn 0x0c
  cmd 0x02
  match 01 05
  data 11 00 11 22 33 44 55
end
respond mask
  netfn 0x0c
  cmd 0x02
  match 01 06
  data 11 ff ff ff 00
end
respond header
  netfn 0x0c
  cmd 0x02
  match 01 07
  data 11 40 e0 bf
end
respond arp
  netfn 0x0c
  cmd 0x02
  match 01 0a
  data 11 03
end
respond grat
  netfn 0x0c
  cmd 0x02
  match 01 0b
  data 11 05
end
respond gateway
  netfn 0x0c
  cmd 0x02
  match 01 0c
  data 11 c0 a8 01 01
end
respond gateway_mac
  netfn 0x0c
  cmd 0x02
  match 01 0d
  data 11 aa bb cc dd ee ff
end
respond backup
  netfn 0x0c
  cmd 0x02
  match 01 0e
  data 11 0a 00 00 01
end
respond backup_mac
  netfn 0x0c
  cmd 0x02
  match 01 0f
  data 11 01 02 03 04 05 06
end
respond snmp
  netfn 0x0c
  cmd 0x02
  match 01 10
  data 11 70 75 62 6c 69 63 00 00 00 00 00 00 00 00 00 00 00 00
end
respond vlan
  netfn 0x0c
  cmd 0x02
  match 01 14
  data 11 23 81
end
respond vlan_priority
  netfn 0x0c
  cmd 0x02
  match 01 15
  data 11 05
end
respond cipher_count
  netfn 0x0c
  cmd 0x02
  match 01 16
  data 11 04
end
respond ciphers
  netfn 0x0c
  cmd 0x02
  match 01 17
  data 11 00 01 02 03 04
end
respond cipher_privs
  netfn 0x0c
  cmd 0x02
  match 01 18
  data 11 00 21 43 05 12 34 50 01 02
end
respond bad_password
  netfn 0x0c
  cmd 0x02
  match 01 1a
  data 11 01 04 06 00 0c 00
end
