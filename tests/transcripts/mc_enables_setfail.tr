# Get BMC Global Enables succeeds but Set BMC Global Enables is rejected, so
# that the failure path after a successful read is reachable.

default_ccode 0xc1

respond get_bmc_global_enables
  netfn 0x06
  cmd 0x2f
  data 0f
end

respond set_bmc_global_enables
  netfn 0x06
  cmd 0x2e
  ccode 0xd4
end
