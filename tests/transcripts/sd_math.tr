respond get_sensor_reading
  netfn 0x04
  cmd 0x2d
  # raw reading 0xb7 for every sensor
  data b7 c0 c0 00
end

respond get_sensor_factors
  netfn 0x04
  cmd 0x23
  # Get Sensor Reading Factors: next reading 0x00,
  # M = 0x12d = 301, tol = 6, B = 0x111 = 273,
  # acc/accexp/dir, Rexp = -2 / Bexp = -1
  data 00 2d 86 11 84 21 e7
end

respond get_sensor_thresholds
  netfn 0x04
  cmd 0x27
  data 3f 36 25 14 c3 d2 e1
end

respond get_sensor_hysteresis
  netfn 0x04
  cmd 0x24
  data 1b 2c
end

respond get_sensor_event_enable
  netfn 0x04
  cmd 0x29
  data c0 ff 3f ff 3f
end
