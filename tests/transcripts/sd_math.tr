# Full Sensor Records that exercise every arm of sdr_convert_sensor_reading(),
# sdr_convert_sensor_hysterisis() and sdr_convert_sensor_tolerance().
#
# All of them share the same reading factors:
#
#     M = 17, tolerance = 42, B = -321, Bexp = -2, Rexp = -3, raw = 0xb7 (183)
#
# so the linear result is ((17 * 183) + (-321 * 10^-2)) * 10^-3 = 3.10779, a
# value whose third decimal place rounds.  Every linearization arm then maps
# that to a distinct printed number, so a mutation that picks the wrong arm,
# the wrong exponent or the wrong association order changes the output.
#
# M and B are stored as 10-bit two's-complement fields split across two bytes;
# the negative-M and negative-B records below make the sign extension and the
# `MS 2 bits' placement observable.

default_ccode 0xc1

respond get_device_id
  netfn 0x06
  cmd 0x01
  data 20 81 01 00 02 bf 57 00 00 00 00 00 00 00 00
end

respond sdr_repo_info
  netfn 0x0a
  cmd 0x20
  data 51 17 00 68 24 00 e3 0b 5e 08 19 2a 3b 02
end

respond reserve_sdr_repo
  netfn 0x0a
  cmd 0x22
  data 5a a5
end

respond get_sdr_first
  netfn 0x0a
  cmd 0x23
  match 5a a5 00 00
  data 02 11
  partial 4 1 5
  blob @sdr/sd_math_41.hex
end

respond get_sdr_1101
  netfn 0x0a
  cmd 0x23
  match 5a a5 01 11
  data 02 11
  partial 4 1 5
  blob @sdr/sd_math_41.hex
end

