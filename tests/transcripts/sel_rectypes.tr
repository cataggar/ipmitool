# One SEL record of every record-type class ipmi_sel.c distinguishes.
# 
#   02h      standard system event
#   bfh      still below C0h, so parsed as a system event
#   c0h/dfh  OEM timestamped, the two ends of the range
#   e0h/efh  OEM non-timestamped
#   f0h      the Linux kernel panic pseudo record, printed from evt+5
#   ffh      OEM non-timestamped, all bits set
# 
# The efh record's OEM bytes mix printable and non-printable values so that
# hex2ascii()'s `>= 0x20 && <= 0x7e' test is exercised in both directions at
# both ends of the range.

default_ccode 0xc1

respond get_device_id
  netfn 0x06
  cmd 0x01
  data 20 81 02 03 02 bf 57 01 00 01 00 00 00 00 00
end

respond get_sel_info
  netfn 0x0a
  cmd 0x40
  data 51 08 00 ff ff 00 e3 0b 5e 00 00 00 00 0a
end

respond reserve_sel
  netfn 0x0a
  cmd 0x42
  data 01 00
end

respond get_sel_0000
  netfn 0x0a
  cmd 0x43
  match 00 00 00 00
  data 01 00 01 03 02 4d 3e 2f 6a 20 00 04 01 01 01 59 55 55
end

respond get_sel_0001
  netfn 0x0a
  cmd 0x43
  match 00 00 01 00
  data 02 00 02 03 bf 4e 3e 2f 6a 21 00 04 02 02 ef 01 02 03
end

respond get_sel_0002
  netfn 0x0a
  cmd 0x43
  match 00 00 02 00
  data 03 00 03 03 c0 4f 3e 2f 6a 44 55 66 01 23 45 67 89 ab
end

respond get_sel_0003
  netfn 0x0a
  cmd 0x43
  match 00 00 03 00
  data 04 00 04 03 df 50 3e 2f 6a 77 88 99 ba 98 76 54 32 10
end

respond get_sel_0004
  netfn 0x0a
  cmd 0x43
  match 00 00 04 00
  data 05 00 05 03 e0 41 42 43 44 45 46 47 48 49 4a 4b 4c 4d
end

respond get_sel_0005
  netfn 0x0a
  cmd 0x43
  match 00 00 05 00
  data 06 00 06 03 ef 7f 80 00 20 7e 41 42 43 1f ff 61 62 63
end

respond get_sel_0006
  netfn 0x0a
  cmd 0x43
  match 00 00 06 00
  data 07 00 07 03 f0 6b 65 72 6e 65 6c 20 70 61 6e 69 63 21
end

respond get_sel_0007
  netfn 0x0a
  cmd 0x43
  match 00 00 07 00
  data ff ff 08 03 ff ff ff ff ff ff ff ff ff ff ff ff ff ff
end
