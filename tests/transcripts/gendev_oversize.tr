default_ccode 0xc1
respond device
  netfn 0x06
  cmd 0x01
  data @mc/device_id.hex
end
respond repository
  netfn 0x0a
  cmd 0x20
  data 51 01 00 ff ff 00 00 00 00 00 00 00 00 02
end
respond reserve
  netfn 0x0a
  cmd 0x22
  data a5 5a
end
respond first
  netfn 0x0a
  cmd 0x23
  match a5 5a 00 00
  data ff ff
  partial 4 1 5
  blob @gendev/oversize.hex
end
respond oversize
  netfn 0x0a
  cmd 0x23
  match a5 5a 67 45
  data ff ff
  partial 4 1 5
  blob @gendev/oversize.hex
end
