# Same as bmc.tr's channel answer but reporting the *system interface* medium,
# which makes is_system() true: ipmi_send_platform_event() then prepends the
# SMS generator ID and sends 8 bytes instead of 7.
default_ccode 0xc1

respond get_channel_info
  netfn 0x06
  cmd 0x42
  # channel 0x0f, medium 0x0c = system interface, protocol KCS,
  # session-less, vendor IANA 7154
  data 0f 0c 01 00 f2 1b 00 00 00
end

respond platform_event_message
  netfn 0x04
  cmd 0x02
  data
end
