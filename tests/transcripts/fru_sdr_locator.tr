respond get_device_id
  netfn 0x06
  cmd 0x01
  data @mc/device_id.hex
end
respond get_fru_area_info
  netfn 0x0a
  cmd 0x10
  data 00 01 00
end
respond read_fru_data
  netfn 0x0a
  cmd 0x11
  partial 1 2 3 count_prefix
  blob @fru/board.hex
end
respond sdr_repo_info
  netfn 0x0a
  cmd 0x20
  data 51 01 00 ff ff 00 00 00 00 00 00 00 00 02
end
respond reserve_sdr_repo
  netfn 0x0a
  cmd 0x22
  data 01 00
end
respond get_sdr_first
  netfn 0x0a
  cmd 0x23
  match 01 00 00 00
  data ff ff
  partial 4 1 5
  blob @sdr/fru_locator_second.hex
end
respond get_sdr_second
  netfn 0x0a
  cmd 0x23
  match 01 00 07 00
  data ff ff
  partial 4 1 5
  blob @sdr/fru_locator_second.hex
end
