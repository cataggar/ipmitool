default_ccode 0xc1
respond device_id
  netfn 0x06
  cmd 0x01
  data @mc/device_id.hex
end
respond repository
  netfn 0x0a
  cmd 0x20
  data 51 03 00 ff ff 00 00 00 00 00 00 00 00 02
end
respond reserve
  netfn 0x0a
  cmd 0x22
  data 01 00
end
respond logical
  netfn 0x0a
  cmd 0x23
  match 01 00 00 00
  data 02 00
  partial 4 1 5
  blob @sunoem/led_group.hex
end
respond logical_body
  netfn 0x0a
  cmd 0x23
  match 01 00 01 00
  data 02 00
  partial 4 1 5
  blob @sunoem/led_group.hex
end
respond physical
  netfn 0x0a
  cmd 0x23
  match 01 00 02 00
  data 03 00
  partial 4 1 5
  blob @sunoem/led_child.hex
end
respond association
  netfn 0x0a
  cmd 0x23
  match 01 00 03 00
  data ff ff
  partial 4 1 5
  blob @sunoem/led_assoc.hex
end
respond get_led
  netfn 0x2e
  cmd 0x21
  data 01
end
respond set_led
  netfn 0x2e
  cmd 0x22
end
