# One record per clause of ipmi_sel_print_extended_entry_verbose().
# 
# That printer only runs from `sel get', and only after
# ipmi_sdr_find_sdr_bynumtype() matches the record's generator ID, sensor number
# and sensor type, so this repository carries an SDR for every identity the
# records below present.  Records 7101..7105 walk both event-data switches of the
# threshold branch with event data 2 and 3 set to different values, so the two
# `OEM Data' and two `Sensor Extension Code' arms cannot be confused.  Record
# 7111 is a threshold event against a *compact* record and 7112 a non-threshold
# event against a *full* one, which pins both halves of the branch condition.
# Records 7131..7136 isolate the CPU/DIMM decode and its three near misses,
# 7141..7143 the version-change clause that deliberately prints nothing, and
# 7151/7152 the kernel-panic record type and the value one above it.
# 
# The panic string doubles as the record's standard-type overlay: "PANIC HERE!"
# puts 4Eh 49h in the generator ID, 20h in the sensor type and 48h in the sensor
# number, which is exactly the sensor ev_panic.hex describes.

default_ccode 0xc1

respond get_device_id
  netfn 0x06
  cmd 0x01
  data 20 81 02 03 02 bf 57 01 00 01 00 00 00 00 00
end

respond get_sel_7101
  netfn 0x0a
  cmd 0x43
  match 00 00 01 71
  data ff ff 01 71 02 4d 3e 2f 6a 20 00 04 01 01 01 10 b7 4e
end

respond get_sel_7102
  netfn 0x0a
  cmd 0x43
  match 00 00 02 71
  data ff ff 02 71 02 4d 3e 2f 6a 20 00 04 01 01 01 60 b7 4e
end

respond get_sel_7103
  netfn 0x0a
  cmd 0x43
  match 00 00 03 71
  data ff ff 03 71 02 4d 3e 2f 6a 20 00 04 01 01 01 b0 b7 4e
end

respond get_sel_7104
  netfn 0x0a
  cmd 0x43
  match 00 00 04 71
  data ff ff 04 71 02 4d 3e 2f 6a 20 00 04 01 01 01 c0 b7 4e
end

respond get_sel_7105
  netfn 0x0a
  cmd 0x43
  match 00 00 05 71
  data ff ff 05 71 02 4d 3e 2f 6a 20 00 04 01 01 01 50 b7 4e
end

respond get_sel_7111
