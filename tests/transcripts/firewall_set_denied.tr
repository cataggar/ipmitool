default_ccode 0xc1
respond netfn_support
  netfn 0x06
  cmd 0x09
  data 01 04 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
end
respond command_support
  netfn 0x06
  cmd 0x0a
  data ff ff ff ff ff ff ff ff ff ff ff ff ff ff ff ff
end
respond command_config
  netfn 0x06
  cmd 0x0c
  data ff ff ff ff ff ff ff ff ff ff ff ff ff ff ff ff
end
respond command_enabled
  netfn 0x06
  cmd 0x61
  data 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
end
respond set_denied
  netfn 0x06
  cmd 0x60
  ccode 0xd5
end
