# Readback is the new value for `lan set 1 ipaddr 192.0.2.10`.
default_ccode 0x80
respond medium
  netfn 0x06
  cmd 0x42
  data 01 04 01 84 f2 1b 00 00 00
end
respond in_progress
  netfn 0x0c
  cmd 0x02
  match 01 00
  ccode 0x80
end
respond readback
  netfn 0x0c
  cmd 0x02
  match 01 03
  data 11 c0 00 02 0a
end
respond write
  netfn 0x0c
  cmd 0x01
end
