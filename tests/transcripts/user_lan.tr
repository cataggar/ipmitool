# A LAN channel plus successful user writes: enough for the two `lan set'
# paths that call into lib/ipmi_user.c (`lan set <ch> password' calls
# _ipmi_set_user_password, `lan set <ch> user' calls _ipmi_set_user_access).
default_ccode 0xc1

respond get_channel_info
  netfn 0x06
  cmd 0x42
  # channel 1, medium 802.3 LAN, protocol IPMB-1.0, one active session
  data 01 04 01 41 00 00 00 00 00
end

respond set_user_access
  netfn 0x06
  cmd 0x43
end

respond get_user_access
  netfn 0x06
  cmd 0x44
  data 04 41 01 34
end

respond set_user_password
  netfn 0x06
  cmd 0x47
end
