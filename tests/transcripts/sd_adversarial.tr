# Malformed and edge-case SDR records.  The BMC supplies these bytes, so they
# are untrusted input; the C's behaviour is the specification even where it is
# wrong (see the upstream defects issue linked from the PR).
#
# Every truncation here stops at a byte the C is still allowed to read: the
# record buffer is malloc(len + 1) and memset to zero, so index `len' is a
# guaranteed NUL.  Truncations that would read past index `len' are genuine
# out-of-bounds reads whose result is heap-dependent and therefore cannot be
# snapshotted; they are reported as an upstream defect instead.

default_ccode 0xc1

respond get_device_id
  netfn 0x06
  cmd 0x01
  data 20 81 01 00 02 bf 57 00 00 00 00 00 00 00 00
end

respond sdr_repo_info
  netfn 0x0a
  cmd 0x20
  data 51 24 00 5a 3c 00 e3 0b 5e 00 00 00 00 02
end

respond reserve_sdr_repo
  netfn 0x0a
  cmd 0x22
  data 5a a5
end

respond get_sdr_first
  netfn 0x0a
  cmd 0x23
  match 5a a5 00 00
  data 02 21
  partial 4 1 5
  blob @sdr/sd_adv_full_t42.hex
end

