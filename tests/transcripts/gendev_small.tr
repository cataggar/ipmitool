default_ccode 0xc1

respond device
  netfn 0x06
  cmd 0x01
  data @mc/device_id.hex
end
respond repository
  netfn 0x0a
  cmd 0x20
  data 51 03 00 ff ff 00 00 00 00 00 00 00 00 02
end
respond reserve
  netfn 0x0a
  cmd 0x22
  data a5 5a
end
respond first
  netfn 0x0a
  cmd 0x23
  match a5 5a 00 00
  data bc 9a
  partial 4 1 5
  blob @gendev/small.hex
end
respond small
  netfn 0x0a
  cmd 0x23
  match a5 5a 34 12
  data bc 9a
  partial 4 1 5
  blob @gendev/small.hex
end
respond unsupported
  netfn 0x0a
  cmd 0x23
  match a5 5a bc 9a
  data 04 00
  partial 4 1 5
  blob @gendev/unsupported.hex
end
respond fru
  netfn 0x0a
  cmd 0x23
  match a5 5a 04 00
  data ff ff
  partial 4 1 5
  blob @sdr/fru_locator.hex
end
respond read
  netfn 0x06
  cmd 0x52
  match 5b a6 08
  partial 3 1 2
  blob @gendev/small-data.hex
end
respond write
  netfn 0x06
  cmd 0x52
  match 5b a6 00
end
