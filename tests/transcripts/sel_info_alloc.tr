# Get SEL Allocation Info supported: four 16-bit fields with distinct bytes.

default_ccode 0xc1

respond get_device_id
  netfn 0x06
  cmd 0x01
  data 20 81 02 03 02 bf 57 01 00 01 00 00 00 00 00
end

respond get_sel_info
  netfn 0x0a
  cmd 0x40
  data 51 03 02 00 05 44 33 22 11 88 77 66 55 0f
end

respond get_sel_alloc
  netfn 0x0a
  cmd 0x41
  data 34 12 78 56 bc 9a f0 de 10
end
