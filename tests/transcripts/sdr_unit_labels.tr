# Full sensors with every unit relation and the unspecified-percent special
# case. Reuses the C-oracle adversarial records, without its malformed tail.
default_ccode 0xc1

respond get_device_id
  netfn 0x06
  cmd 0x01
  data 20 81 01 00 02 bf 57 00 00 00 00 00 00 00 00
end

respond sdr_repo_info
  netfn 0x0a
  cmd 0x20
  data 51 06 00 5a 3c 00 e3 0b 5e 00 00 00 00 02
end

respond reserve_sdr_repo
  netfn 0x0a
  cmd 0x22
  data 5a a5
end

respond get_sdr_first
  netfn 0x0a
  cmd 0x23
  match 5a a5 00 00
  data 24 21
  partial 4 1 5
  blob @sdr/sd_adv_unit_max.hex
end

respond get_sdr_2123
  netfn 0x0a
  cmd 0x23
  match 5a a5 23 21
  data 24 21
  partial 4 1 5
  blob @sdr/sd_adv_unit_max.hex
end

respond get_sdr_2124
  netfn 0x0a
  cmd 0x23
  match 5a a5 24 21
  data 25 21
  partial 4 1 5
  blob @sdr/sd_adv_unit_bad.hex
end

respond get_sdr_2125
  netfn 0x0a
  cmd 0x23
  match 5a a5 25 21
  data 26 21
  partial 4 1 5
  blob @sdr/sd_adv_unit_div.hex
end

respond get_sdr_2126
  netfn 0x0a
  cmd 0x23
  match 5a a5 26 21
  data 27 21
  partial 4 1 5
  blob @sdr/sd_adv_unit_mul.hex
end

respond get_sdr_2127
  netfn 0x0a
  cmd 0x23
  match 5a a5 27 21
  data 28 21
  partial 4 1 5
  blob @sdr/sd_adv_unit_pct0.hex
end

respond get_sdr_2128
  netfn 0x0a
  cmd 0x23
  match 5a a5 28 21
  data ff ff
  partial 4 1 5
  blob @sdr/sd_adv_unit_pctu.hex
end

respond get_sensor_reading
  netfn 0x04
  cmd 0x2d
  data 5b c0 c0 00
end

respond get_sensor_thresholds
  netfn 0x04
  cmd 0x27
  data 3f 0f 0a 05 4b 55 5f
end

respond get_sensor_hysteresis
  netfn 0x04
  cmd 0x24
  data 02 02
end

respond get_sensor_event_enable
  netfn 0x04
  cmd 0x29
  data c0 ff 3f ff 3f
end
