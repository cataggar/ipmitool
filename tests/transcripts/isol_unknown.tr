# Both values fall back to the shared static buffer in val2str().
default_ccode 0xc1
respond enabled
  netfn 0x34
  cmd 0x04
  match 00 01 00 00
  data 11 82
end
respond authentication
  netfn 0x34
  cmd 0x04
  match 00 02 00 00
  data 12 8e
end
respond baud
  netfn 0x34
  cmd 0x04
  match 00 05 00 00
  data 13 8f
end
