default_ccode 0xc1
respond vita_discover
  netfn 0x2c
  cmd 0x00
  match 03
  times 1
  data 03 11 10 00 01 01 00
end
respond vita_ipmb
  netfn 0x2c
  cmd 0x40
  match 03
  times 1
  data 03 41 82 ff 00 01 00
end
respond wrong_properties
  netfn 0x2c
  cmd 0x00
  data 02 11 10 00 01 01 00
end
respond wrong_address
  netfn 0x2c
  cmd 0x40
  data 02 41 82 ff 00 01 00
end
respond wrong_control
  netfn 0x2c
  cmd 0x04
  data 02
end
respond wrong_prop
  netfn 0x2c
  cmd 0x05
  data 02 00 01
end
respond wrong_cap
  netfn 0x2c
  cmd 0x06
  data 02 01 01 01
end
respond wrong_set
  netfn 0x2c
  cmd 0x07
  data 02
end
respond wrong_get
  netfn 0x2c
  cmd 0x08
  data 02 01 ff 00 01
end
respond wrong_policy_set
  netfn 0x2c
  cmd 0x0a
  data 02
end
respond wrong_policy_get
  netfn 0x2c
  cmd 0x0b
  data 02 01
end
respond wrong_activate
  netfn 0x2c
  cmd 0x0c
  data 02
end
