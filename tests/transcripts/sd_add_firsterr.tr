# Reject the first SDR header, then accept every chunk of the second SDR.
# An earlier failed Add must not be hidden by the later successful Add.

default_ccode 0xc1

respond get_device_id
  netfn 0x06
  cmd 0x01
  data 20 81 01 00 02 bf 57 00 00 00 00 00 00 00 00
end

respond reserve_sdr_repo
  netfn 0x0a
  cmd 0x22
  data 5a a5
end

respond sdr_repo_clear
  netfn 0x0a
  cmd 0x27
  match 5a a5 43 4c 52 aa
  data 01
end

respond get_dev_sdr_info
  netfn 0x04
  cmd 0x20
  data 02 01
end

respond reserve_dev_sdr
  netfn 0x04
  cmd 0x22
  data 5a a5
end

respond get_dev_sdr_first
  netfn 0x04
  cmd 0x21
  match 5a a5 00 00
  data 78 56
  partial 4 1 5
  blob @sdr/sd_full_temp.hex
end

respond get_dev_sdr_1234
  netfn 0x04
  cmd 0x21
  match 5a a5 34 12
  data 78 56
  partial 4 1 5
  blob @sdr/sd_full_temp.hex
end

respond get_dev_sdr_5678
  netfn 0x04
  cmd 0x21
  match 5a a5 78 56
  data ff ff
  partial 4 1 5
  blob @sdr/sd_compact_fan.hex
end

respond reject_first_sdr
  netfn 0x0a
  cmd 0x25
  match 5a a5 00 00 00 00 34 12
  ccode 0x80
end

respond add_partial_sdr
  netfn 0x0a
  cmd 0x25
  data 3c 4b
end
