default_ccode 0xc1
respond capabilities
  netfn 0x04
  cmd 0x10
  data 51 3f 03
end
respond size
  netfn 0x04
  cmd 0x13
  match 05
  data 11 83
end
respond filter1
  netfn 0x04
  cmd 0x13
  match 06 01
  data 11 01 80 3f 05 19 39 01 01 27 01 03 00 00 00 00 00 00 00 00 00 00
end
respond filter2
  netfn 0x04
  cmd 0x13
  match 06 02
  data 11 02 00 00 00 00 00 00 00 00 ff ff ff 00 00 00 00 00 00 00 00 00
end
respond filter3
  netfn 0x04
  cmd 0x13
  match 06 03
  data 11 03 c0 01 0f 20 00 00 ff ff 70 01 00 00 00 00 00 00 00 00 00 00
end
respond set_filter
  netfn 0x04
  cmd 0x12
  match 07
  data
end
