# A BMC used for the file-driven SEL subcommands.
# 
# `sel readraw' and `sel ereadraw' do not talk to the BMC at all beyond the
# interface setup, and `sel add' issues one Add SEL Entry (0Ah/44h) per parsed
# line.  The Add SEL Entry reply carries record ID 7788h.

default_ccode 0xc1

respond get_device_id
  netfn 0x06
  cmd 0x01
  data 20 81 02 03 02 bf 57 01 00 01 00 00 00 00 00
end

respond get_sel_info
  netfn 0x0a
  cmd 0x40
  data 51 05 00 ff ff 00 e3 0b 5e 00 00 00 00 0a
end

respond reserve_sel
  netfn 0x0a
  cmd 0x42
  data cd ab
end

respond add_sel
  netfn 0x0a
  cmd 0x44
  data 88 77
end

respond get_sdr_repo_info
  netfn 0x0a
  cmd 0x20
  ccode 0xc1
end
