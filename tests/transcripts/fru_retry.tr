# The first 23-byte read is too large. The retry must shrink its request.
respond get_fru_area_info
  netfn 0x0a
  cmd 0x10
  data 00 01 00
end
respond read_too_large
  netfn 0x0a
  cmd 0x11
  match 00 00 00 17
  times 1
  ccode 0xc7
end
respond read_fru_data
  netfn 0x0a
  cmd 0x11
  partial 1 2 3 count_prefix
  blob @fru/board.hex
end
