# A BMC with one FRU inventory device (id 0) holding a 256-byte image.
#
# Exercises the FRU walk in lib/ipmi_fru.c: Get FRU Inventory Area Info
# (0Ah/10h) then repeated Read FRU Data (0Ah/11h). Read FRU Data request data
# is `FRU id, offset LSB, offset MSB, count', and the reply starts with the
# number of bytes actually returned, which is exactly `partial 1 2 3
# count_prefix'.

default_ccode 0xc1

respond get_device_id
  netfn 0x06
  cmd 0x01
  data @mc/device_id.hex
end

respond get_fru_area_info
  netfn 0x0a
  cmd 0x10
  # 256 bytes, accessed by byte (bit 0 clear)
  data 00 01 00
end

respond read_fru_data
  netfn 0x0a
  cmd 0x11
  partial 1 2 3 count_prefix
  blob @fru/board.hex
end

# `fru print' walks the SDR repository looking for FRU device locator records
# when no explicit FRU id is given, so the SDR side has to answer too.
respond sdr_repo_info
  netfn 0x0a
  cmd 0x20
  data 51 01 00 ff ff 00 00 00 00 00 00 00 00 02
end
respond reserve_sdr_repo
  netfn 0x0a
  cmd 0x22
  data 01 00
end
respond get_sdr_first
  netfn 0x0a
  cmd 0x23
  match 01 00 00 00
  data ff ff
  partial 4 1 5
  blob @sdr/fru_locator.hex
end
respond get_sdr_0004
  netfn 0x0a
  cmd 0x23
  match 01 00 04 00
  data ff ff
  partial 4 1 5
  blob @sdr/fru_locator.hex
end
