# A BMC that reports its six thresholds *out of order*: upper non-critical is
# above upper critical, upper non-recoverable is below upper critical, lower
# non-recoverable is above lower critical and lower non-critical is below it.
#
#   0xb47e  full, threshold, analog, M=1                        "Disord"
#
# Threshold readback (all six readable):
#
#   lnc 0x0d = 13    lcr 0x1b = 27    lnr 0x27 = 39
#   unc 0xa5 = 165   ucr 0x7c = 124   unr 0x63 = 99
#
# With M=1, B=0 and both exponents 0, the converted value equals the raw byte.
# The ordering is what matters: it makes the *second* and *third* clauses of
# ipmi_sensor_set_threshold()'s validation chain the deciding ones, which a
# well-ordered BMC can never do.  See tests/fixtures/sensor/full_disorder.hex.

default_ccode 0xc1

respond get_device_id
  netfn 0x06
  cmd 0x01
  data @mc/device_id.hex
end

respond sdr_repo_info
  netfn 0x0a
  cmd 0x20
  # SDR version 51h, 1 record, 0xffff free bytes, reserve supported
  data 51 01 00 ff ff 00 00 00 00 00 00 00 00 02
end

respond reserve_sdr_repo
  netfn 0x0a
  cmd 0x22
  data a5 5a
end

respond get_sdr_first
  netfn 0x0a
  cmd 0x23
  match a5 5a 00 00
  # 0xffff is SDR_RECORD_ID_LAST: end of repository
  data ff ff
  partial 4 1 5
  blob @sensor/full_disorder.hex
end
respond get_sdr_b47e
  netfn 0x0a
  cmd 0x23
  match a5 5a 7e b4
  data ff ff
  partial 4 1 5
  blob @sensor/full_disorder.hex
end

respond reading_99
  netfn 0x04
  cmd 0x2d
  match 99
  # raw 0x39 = 57; M=1 => 57 degrees C
  data 39 c0 c0 00
end

respond thresh_99
  netfn 0x04
  cmd 0x27
  match 99
  # readable mask, lnc 0d, lcr 1b, lnr 27, unc a5, ucr 7c, unr 63
  data 3f 0d 1b 27 a5 7c 63
end

respond hysteresis
  netfn 0x04
  cmd 0x24
  data 07 0d
end

respond event_enable
  netfn 0x04
  cmd 0x29
  data c0 ff 3f ff 3f
end

respond set_thresh
  netfn 0x04
  cmd 0x26
end
