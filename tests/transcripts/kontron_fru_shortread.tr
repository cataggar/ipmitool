default_ccode 0xc1
respond serial
  netfn 0x3e
  cmd 0x0c
  data 53 4e 31 32
end
respond date
  netfn 0x3e
  cmd 0x0e
  data 12 34 56
end
respond fru_info
  netfn 0x0a
  cmd 0x10
  data d0 00 00
end
respond fru_header
  netfn 0x0a
  cmd 0x11
  match 00 00 00 08
  data 08 01 00 00 01 08 18 00 de
end
respond fru_short_board
  netfn 0x0a
  cmd 0x11
  match 00 08 00 17
  data 17 01 03
end
