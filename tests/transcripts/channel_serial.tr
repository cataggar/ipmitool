# Channel 3 is an RS-232 serial channel: `channel info' prints the header and
# stops, because only LAN channels get the Channel Access blocks.  Session
# support is 00h (session-less) and the vendor ID is a non-IPMI-forum value.
default_ccode 0xc1

respond get_channel_info
  netfn 0x06
  cmd 0x42
  # channel 3, medium 05h RS-232, protocol 04h basic mode, session-less,
  # 0 active sessions, vendor IANA 0x000abc, aux ff ff
  data 03 05 04 00 bc 0a 00 ff ff
end

respond get_channel_access
  netfn 0x06
  cmd 0x41
  data 22 04
end
