# Invalid fixed/name lengths must never escape the SDR reader; the last two
# records prove valid short and maximum-length names still work.
default_ccode 0xc1

respond get_device_id
  netfn 0x06
  cmd 0x01
  data @mc/device_id.hex
end
respond sdr_repo_info
  netfn 0x0a
  cmd 0x20
  data 51 05 00 ff ff 00 00 00 00 00 00 00 00 02
end
respond reserve_sdr_repo
  netfn 0x0a
  cmd 0x22
  data a5 5a
end
respond short_fixed
  netfn 0x0a
  cmd 0x23
  match a5 5a 00 00
  data 02 10
  partial 4 1 5
  blob @sensor/full_short_fixed.hex
end
respond short_fixed_by_id
  netfn 0x0a
  cmd 0x23
  match a5 5a 01 10
  data 02 10
  partial 4 1 5
  blob @sensor/full_short_fixed.hex
end
respond name_overrun
  netfn 0x0a
  cmd 0x23
  match a5 5a 02 10
  data 03 10
  partial 4 1 5
  blob @sensor/full_name_overrun.hex
end
respond name_too_long
  netfn 0x0a
  cmd 0x23
  match a5 5a 03 10
  data 04 10
  partial 4 1 5
  blob @sensor/full_name_too_long.hex
end
respond valid_short_name
  netfn 0x0a
  cmd 0x23
  match a5 5a 04 10
  data 05 10
  partial 4 1 5
  blob @sensor/full_valid_short_name.hex
end
respond valid_max_name
  netfn 0x0a
  cmd 0x23
  match a5 5a 05 10
  data ff ff
  partial 4 1 5
  blob @sensor/full_valid_max_name.hex
end
respond reading
  netfn 0x04
  cmd 0x2d
  match 11
  data 30 c0 c0 00
end
respond thresholds
  netfn 0x04
  cmd 0x27
  data 3f 0f 0a 05 4b 55 5f
end
respond hysteresis
  netfn 0x04
  cmd 0x24
  data 07 0d
end
respond event_enable
  netfn 0x04
  cmd 0x29
  data c0 ff 3f ff 3f
end
