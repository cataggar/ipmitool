# A BMC that rejects both SEL clock commands.

default_ccode 0xc1

respond get_device_id
  netfn 0x06
  cmd 0x01
  data 20 81 02 03 02 bf 57 01 00 01 00 00 00 00 00
end

respond get_sel_time_fail
  netfn 0x0a
  cmd 0x48
  ccode 0xd5
end

respond set_sel_time_fail
  netfn 0x0a
  cmd 0x49
  ccode 0xd5
end
