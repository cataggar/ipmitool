respond validator
  netfn 0x06
  cmd 0x59
  match 00 dd
  data @pad 10 0x00 10
end
respond lom_header
  netfn 0x06
  cmd 0x59
  match 00 da 00 00 00 00
  data 11 00
end
respond virtual_zero
  netfn 0x30
  cmd 0xc9
  data @pad 13 0x00
end
respond lan_mac
  netfn 0x0c
  cmd 0x02
  data 11 10 20 30 40 50 60
end
