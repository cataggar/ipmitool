# An unrecognised SDR repository version produces a warning on stderr but the
# walk proceeds normally.

default_ccode 0xc1

respond get_device_id
  netfn 0x06
  cmd 0x01
  data 20 81 01 00 02 bf 57 00 00 00 00 00 00 00 00
end

respond sdr_repo_info
  netfn 0x0a
  cmd 0x20
  # SDR repository version 0x99 is none of 0x01/0x02/0x51
  data 99 02 00 34 12 00 e3 0b 5e 00 00 00 00 02
end

respond reserve_sdr_repo
  netfn 0x0a
  cmd 0x22
  data 5a a5
end

respond get_sdr_first
  netfn 0x0a
  cmd 0x23
  match 5a a5 00 00
  data 78 56
  partial 4 1 5
  blob @sdr/sd_full_temp.hex
end

respond get_sdr_1234
  netfn 0x0a
  cmd 0x23
  match 5a a5 34 12
  data 78 56
  partial 4 1 5
  blob @sdr/sd_full_temp.hex
end

respond get_sdr_5678
  netfn 0x0a
  cmd 0x23
  match 5a a5 78 56
  data ff ff
  partial 4 1 5
  blob @sdr/sd_compact_fan.hex
end

respond get_sensor_reading
  netfn 0x04
  cmd 0x2d
  data 2a c0 c0 00
end

respond get_sensor_thresholds
  netfn 0x04
  cmd 0x27
  data 3f 0f 0a 05 4b 55 5f
end

respond get_sensor_hysteresis
  netfn 0x04
  cmd 0x24
  data 02 02
end

respond get_sensor_event_enable
  netfn 0x04
  cmd 0x29
  data c0 ff 3f ff 3f
end
