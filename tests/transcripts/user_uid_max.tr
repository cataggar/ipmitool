# max_user_ids = 0x3F = 63 = IPMI_UID_MAX exactly, so the walk lists 63 users
# and stops.  A `<` instead of `<=` on either loop bound loses the last row.
default_ccode 0xc1

respond get_user_access
  netfn 0x06
  cmd 0x44
  data 3f 41 01 34
end

respond get_user_name
  netfn 0x06
  cmd 0x46
  data 75 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
end
