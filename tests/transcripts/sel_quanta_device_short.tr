# The Quanta helper's Get Device ID reply is empty, but has no error code.
default_ccode 0xc1

respond get_device_id
  netfn 0x06
  cmd 0x01
  times 2
  data 20 81 02 03 02 bf 4c 1c 00 01 00 00 00 00 00
end

respond device_short
  netfn 0x06
  cmd 0x01
  times 1
end

respond get_device_id_later
  netfn 0x06
  cmd 0x01
  data 20 81 02 03 02 bf 4c 1c 00 01 00 00 00 00 00
end

respond get_sel_info
  netfn 0x0a
  cmd 0x40
  data 51 01 00 ff ff 00 e3 0b 5e 00 00 00 00 0a
end

respond get_sel_entry
  netfn 0x0a
  cmd 0x43
  data ff ff 01 0a 02 4d 3e 2f 6a 20 00 04 0c 40 6f 00 11 b5
end

respond platform_purley
  netfn 0x36
  cmd 0x65
  match 4c 1c 00 02
  data 02
end
