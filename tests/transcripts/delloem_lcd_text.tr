respond validator
  netfn 0x06
  cmd 0x59
  match 00 dd
  data @pad 10 0x00 10
end
respond support
  netfn 0x06
  cmd 0x59
  match 00 e7
  data 11 09 02 00 00
end
respond mode
  netfn 0x06
  cmd 0x59
  match 00 c2
  data 11 00 00 00 00 00 00 00 00 00 00 02 00
end
respond caps
  netfn 0x06
  cmd 0x59
  match 00 cf
  data 11 01 01 3e 00 00 00
end
respond line0
  netfn 0x06
  cmd 0x59
  match 00 c1 00 00
  data 11 00 00 1e 42 69 6e 61 72 79 20 4c 43 44 20 74 65 78
end
respond line1
  netfn 0x06
  cmd 0x59
  match 00 c1 01 00
  data 11 01 74 20 77 69 74 68 20 74 77 6f 20 62 6c 6f 63 6b
end
