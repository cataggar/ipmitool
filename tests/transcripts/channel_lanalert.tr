# As channel_lanset.tr, but the non-volatile channel access reports privilege
# limit 0Fh (no access).  `lan set 1 alert on' leaves privilege_limit alone, so
# the value travels through _ipmi_get_channel_access() and
# _ipmi_set_channel_access() untouched - which is what tells the `& 0x0f'
# privilege mask apart from a narrower one.
default_ccode 0xc1

respond get_channel_info
  netfn 0x06
  cmd 0x42
  data 01 04 01 84 f2 1b 00 00 00
end

respond get_channel_access_nonvolatile
  netfn 0x06
  cmd 0x41
  match 01 40
  # alerting disabled, per-message auth, user level auth, access mode 5,
  # privilege limit 0Fh
  data 3d 0f
end

respond set_channel_access
  netfn 0x06
  cmd 0x40
end
