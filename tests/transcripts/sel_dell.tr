# A Dell BMC (IANA 674) reporting an IPMI 2.0 device ID.
# 
# get_dell_evt_desc() in lib/ipmi_sel.c decodes the three OEM event data bytes
# per sensor type.  The records below walk every sensor type it handles and,
# within each, every branch that an IPMI 2.0 device ID can reach: processor
# internal and protocol errors, memory CRC and ECC reporting, all seven
# DIMMs-per-node encodings, TXT errors, the watchdog, version change, virtual
# MAC programming, QPI and PCIe error decoding and the POST code table.
# 
# Event data byte 1 must have `10' in bits 7:6 or `10' in bits 5:4 for
# ipmi_get_event_desc() to call the OEM decoder at all, except for the C1h
# (OEM secondary event) form, which is keyed on sensor number 23h instead.

default_ccode 0xc1

respond get_device_id
  netfn 0x06
  cmd 0x01
  data 20 81 02 03 02 bf a2 02 00 01 00 00 00 00 00
end

respond get_sel_info
  netfn 0x0a
  cmd 0x40
  data 51 60 00 ff ff 00 e3 0b 5e 00 00 00 00 0a
end

respond reserve_sel
  netfn 0x0a
  cmd 0x42
  data 01 00
end

respond get_sel_0000
  netfn 0x0a
  cmd 0x43
  match 00 00 00 00
  data 01 00 00 05 02 4d 3e 2f 6a 20 00 04 07 0a 6f 80 01 33
end

respond get_sel_0001
  netfn 0x0a
  cmd 0x43
  match 00 00 01 00
  data 02 00 01 05 02 4d 3e 2f 6a 20 00 04 07 0a 6f 86 01 44
end

