respond get_fru_area_info
  netfn 0x0a
  cmd 0x10
  data 00 01 00
end
respond read_fru_data
  netfn 0x0a
  cmd 0x11
  partial 1 2 3 count_prefix
  blob @fru/board.hex
end
respond chassis_protected
  netfn 0x0a
  cmd 0x12
  match 00 08 00
  ccode 0x80
end
respond write_fru_data
  netfn 0x0a
  cmd 0x12
  data 01
end
