# Every event/reading type class and a spread of sensor types.
# 
#   02h..0ch  generic discrete, resolved through generic_event_types[]
#   0dh..0fh  reserved reading types with no table entry
#   6fh       sensor-specific discrete, over nineteen sensor types
#   70h..7fh  OEM event/reading types, which take the OEM description path
#   2dh..ffh  sensor type codes past SENSOR_TYPE_MAX and into the OEM range
# 
# The last two records are the memory-ECC special case in
# ipmi_sel_print_std_entry() (sensor type 0Ch, sensor number 0, EV1[5:4] == 2)
# and the version-change branch of ipmi_sel_print_extended_entry_verbose() whose
# upstream body is empty.

default_ccode 0xc1

respond get_device_id
  netfn 0x06
  cmd 0x01
  data 20 81 02 03 02 bf 57 01 00 01 00 00 00 00 00
end

respond get_sel_info
  netfn 0x0a
  cmd 0x40
  data 51 3b 00 ff ff 00 e3 0b 5e 00 00 00 00 0a
end

respond reserve_sel
  netfn 0x0a
  cmd 0x42
  data 01 00
end

respond get_sel_0000
  netfn 0x0a
  cmd 0x43
  match 00 00 00 00
  data 01 00 00 04 02 4d 3e 2f 6a 20 00 04 05 02 02 02 1f 2e
end

