default_ccode 0xc1

respond device
  netfn 0x06
  cmd 0x01
  data 20 81 02 03 02 bf 98 3a 00 8a 13 09 00 00 00
end

respond info
  netfn 0x08
  cmd 0x00
  data 06 20 01 07 42 02 55
end

respond start
  netfn 0x08
  cmd 0x0a
  data 01
end

respond save
  netfn 0x08
  cmd 0x0b
end

respond finish
  netfn 0x08
  cmd 0x0c
end

respond bank0
  netfn 0x08
  cmd 0x07
  match 00
  data 01 00 40 00 07 42 09
end

respond bank1
  netfn 0x08
  cmd 0x07
  match 01
  data 00 00 00 00 00 00 00
end

respond upgrade
  netfn 0x08
  cmd 0x09
  match 00
end
