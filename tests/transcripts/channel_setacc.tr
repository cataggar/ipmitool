# Get/Set User Access both succeed.  The Get response seeds every field that
# `channel setaccess' can override, so an option that is *not* given on the
# command line must be echoed back unchanged in the Set request - which the
# harness records byte for byte.
default_ccode 0xc1

respond get_user_access
  netfn 0x06
  cmd 0x44
  # max user ids 4, 1 enabled user, 1 fixed name, byte 3 = 0x34:
  # callin_callback clear, link auth set, ipmi messaging set, privilege 4
  data 04 41 01 34
end

respond set_user_access
  netfn 0x06
  cmd 0x43
end
