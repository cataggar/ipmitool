# An SDR repository that reports zero records.  ipmi_sdr_start() tries to
# rebuild it from the sensors (ipmi_sdr_add_from_sensors), which fails against
# a BMC that does not implement the Add SDR commands.

default_ccode 0xc1

respond get_device_id
  netfn 0x06
  cmd 0x01
  data 20 81 01 00 02 bf 57 00 00 00 00 00 00 00 00
end

respond sdr_repo_info
  netfn 0x0a
  cmd 0x20
  # zero records: ipmi_sdr_start() calls
  # ipmi_sdr_add_from_sensors() to rebuild the repository
  data 51 00 00 34 12 00 e3 0b 5e 00 00 00 00 02
end

respond reserve_sdr_repo
  netfn 0x0a
  cmd 0x22
  data 5a a5
end

respond get_dev_sdr_info
  netfn 0x04
  cmd 0x20
  # Get Device SDR Info: 2 sensors, dynamic population
  data 02 01
end

respond get_sdr_none
  netfn 0x0a
  cmd 0x23
  ccode 0xcb
end
