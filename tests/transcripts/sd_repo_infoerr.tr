# Get SDR Repository Info fails with 0xd5 `Command not supported in present
# state'; the completion code string comes from completion_code_vals.

default_ccode 0xc1

respond get_device_id
  netfn 0x06
  cmd 0x01
  data 20 81 01 00 02 bf 57 00 00 00 00 00 00 00 00
end

respond sdr_repo_info_err
  netfn 0x0a
  cmd 0x20
  ccode 0xd5
end
