# An interface that answers nothing beyond the usual probes.
# 
# `sel interpret' does not talk to the BMC: it reparses a text log. The
# successfully parsed cases have a deterministic pre-init timestamp; PPS
# timezone conversion is left for issue #23.

default_ccode 0xc1

respond get_device_id
  netfn 0x06
  cmd 0x01
  data 20 81 02 03 02 bf 57 01 00 01 00 00 00 00 00
end
