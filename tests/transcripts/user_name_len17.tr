# Get User Name answers with 17 bytes: one more than the required 16.  The
# reply is rejected, which distinguishes `!= 16` from `< 16`.
default_ccode 0xc1

respond get_user_access
  netfn 0x06
  cmd 0x44
  data 04 41 01 34
end

respond get_user_name
  netfn 0x06
  cmd 0x46
  data 61 64 6d 69 6e 00 00 00 00 00 00 00 00 00 00 00 5a
end
