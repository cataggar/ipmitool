default_ccode 0xc1
respond device_id
  netfn 0x06
  cmd 0x01
  data @mc/device_id.hex
end
respond repository
  netfn 0x0a
  cmd 0x20
  data 51 01 00 ff ff 00 00 00 00 00 00 00 00 02
end
respond reserve
  netfn 0x0a
  cmd 0x22
  data 01 00
end
respond record
  netfn 0x0a
  cmd 0x23
  data ff ff
  partial 4 1 5
  blob @sunoem/led_sdr.hex
end
respond empty_get
  netfn 0x2e
  cmd 0x21
end
respond surplus_set
  netfn 0x2e
  cmd 0x22
  data 04
end
