#!golden 1
#!case cmd_pef_help
#!section exit
0
#!section stdout
#!section stderr
usage: pef help
       pef capabilities
       pef event <params>
       pef filter list
       pef filter enable <id = 1..n>
       pef filter disable <id = 1..n>
       pef filter create <id = 1..n> <params>
       pef filter delete <id = 1..n>
       pef info
       pef policy list
       pef policy enable <id = 1..n>
       pef policy disable <id = 1..n>
       pef policy create <id = 1..n> <params>
       pef policy delete <id = 1..n>
       pef pet ack <params>
       pef status
       pef timer get
       pef timer set <0x00-0xFF>
#!section requests
> netfn=0x2c lun=0x00 cmd=0x00 target_cmd=0x00 data=00
< rule=default ccode=0xc1 len=0 data=
> netfn=0x2c lun=0x00 cmd=0x00 target_cmd=0x00 data=03
< rule=default ccode=0xc1 len=0 data=
bye
