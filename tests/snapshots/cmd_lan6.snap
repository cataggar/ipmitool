#!golden 1
#!case cmd_lan6
#!section exit
0
#!section stdout
  help [command]
  save <channel> [<parameter> [<set_sel> [<block_sel>]]]
  set <channel> [nolock] <parameter> [<set_sel> [<block_sel>]] <values...>
  print <channel> [<parameter> [<set_sel> [<block_sel>]]]
  lock <channel>
  commit <channel>
  discard <channel>
#!section stderr
#!section requests
> netfn=0x2c lun=0x00 cmd=0x00 target_cmd=0x00 data=00
< rule=default ccode=0xc1 len=0 data=
> netfn=0x2c lun=0x00 cmd=0x00 target_cmd=0x00 data=03
< rule=default ccode=0xc1 len=0 data=
bye
