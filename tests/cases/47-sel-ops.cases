covers: sel

[sl_save_noargs]
desc: sel dispatch: sel save with no filename
args: -I dummy sel save
transcript: sel_many.tr
covers: sel

[sl_add_noargs]
desc: sel dispatch: sel add with no filename
args: -I dummy sel add
transcript: sel_many.tr
covers: sel

[sl_writeraw_noargs]
desc: sel dispatch: writeraw with no filename
args: -I dummy sel writeraw
transcript: sel_many.tr
covers: sel

[sl_readraw_noargs]
desc: sel dispatch: readraw with no filename
args: -I dummy sel readraw
transcript: sel_many.tr
covers: sel

[sl_ereadraw_noargs]
desc: sel dispatch: ereadraw with no filename
args: -I dummy sel ereadraw
