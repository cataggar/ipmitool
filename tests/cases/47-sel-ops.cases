[sl_time_set_tz]
desc: sel time set interprets the string as local time
args: -I dummy sel time set "03/14/21 15:09:26"
transcript: sel_time.tr
env: TZ=XYZ5
covers: sel

[sl_time_set_tz_utc]
desc: -Z makes sel time set interpret the string as UTC
args: -I dummy -Z sel time set "03/14/21 15:09:26"
transcript: sel_time.tr
env: TZ=XYZ5
covers: sel

[sl_time_get_tz]
desc: sel time get renders the BMC clock in local time
args: -I dummy sel time get
transcript: sel_time.tr
env: TZ=XYZ5
covers: sel
