# Generated for issue #11: lib/ipmi_sel.c.
#
# Kontron, Viking, Supermicro and Quanta OEM event decoding.

[sl_kontron_list]
desc: Kontron OEM sensor event type table
args: -I dummy sel list
transcript: sel_kontron.tr
covers: sel

[sl_kontron_verbose]
desc: verbose Kontron OEM sensor event types
args: -I dummy -v sel elist
transcript: sel_kontron.tr
covers: sel

[sl_viking_list]
desc: Viking OEM description command
args: -I dummy sel list
transcript: sel_viking.tr
covers: sel

[sl_viking_verbose]
desc: Viking OEM description command, verbose
args: -I dummy -v sel list
transcript: sel_viking.tr
covers: sel

[sl_smc_list]
desc: Supermicro OEM decoding, IANA 10876
args: -I dummy sel list
transcript: sel_smc.tr
covers: sel

[sl_smc_verbose]
desc: Supermicro OEM decoding, verbose
args: -I dummy -v sel list
transcript: sel_smc.tr
covers: sel

[sl_smc47488_list]
desc: Supermicro OEM decoding, IANA 47488
args: -I dummy sel list
transcript: sel_smc47488.tr
covers: sel

[sl_smc_fail]
desc: Supermicro decoding when the OEM commands fail
args: -I dummy sel list
transcript: sel_smc_fail.tr
covers: sel

[sl_quanta_list]
desc: Quanta OEM decoding hand-off
args: -I dummy sel list
transcript: sel_quanta.tr
covers: sel

[slq_platform_verbose]
desc: Quanta platform ID debug logging with a promoted byte and %hhx
args: -I dummy -vv sel get 1
transcript: sel_quanta.tr
covers: sel

[slq_elist]
desc: Quanta extended SEL listing
args: -I dummy sel elist
transcript: sel_quanta.tr
covers: sel

[slq_get_memory]
desc: Quanta memory record through sel get
args: -I dummy sel get 1
transcript: sel_quanta.tr
covers: sel

[slq_get_non_memory]
desc: Quanta event with a different sensor type does not probe the platform
args: -I dummy sel get 4
transcript: sel_quanta.tr
covers: sel

[slq_get_nonspecific]
desc: Quanta memory event without event type 6f does not probe the platform
args: -I dummy sel get 5
transcript: sel_quanta.tr
covers: sel

[slq_platform_short]
desc: zero-length platform response after Quanta memory event
args: -I dummy sel list
transcript: sel_quanta_short.tr
covers: sel

[slq_device_short]
desc: zero-length device ID response within the Quanta helper
args: -I dummy sel list
transcript: sel_quanta_device_short.tr
covers: sel

[slq_platform_reject]
desc: completion code from Quanta Get Platform ID
args: -I dummy sel list
transcript: sel_quanta_reject.tr
covers: sel

[slq_device_reject]
desc: completion code from the Quanta helper Get Device ID
args: -I dummy sel list
transcript: sel_quanta_device_reject.tr
covers: sel

[slq_deassert]
desc: Quanta memory event with the direction bit set and nonzero decode fields
args: -I dummy sel list
transcript: sel_quanta_deassert.tr
covers: sel

[slq_get_bad_id]
desc: malformed SEL ID must not send an OEM request
args: -I dummy sel get not-an-id
transcript: sel_quanta.tr
covers: sel

[slq_get_missing_id]
desc: missing SEL ID must not send an OEM request
args: -I dummy sel get
transcript: sel_quanta.tr
covers: sel

[sl_iana_wide]
desc: manufacturer ID with three non-zero bytes
args: -I dummy -vvv sel list
transcript: sel_iana_wide.tr
covers: sel

[sl_smc_boardid_fail]
desc: Supermicro decoding when Get Board ID fails
args: -I dummy sel list
transcript: sel_smc_boardid_fail.tr
covers: sel
