# One case per top-level command in the C command table
# (`ipmitool_cmd_list[]` in src/ipmitool.c), in table order:
#
#   cmd_<name>        the command with no arguments
#   cmd_<name>_help   the command's `help` path
#
# tests/golden/coverage.zig re-reads that table on every run and fails the
# suite if a command has no case here, so adding a command to ipmitool (or
# forgetting to register one in a port) cannot slip through unnoticed.
#
# These cases use the baseline transcript: the point is the argument parsing,
# usage text and exit status, not BMC data. Cases that exercise the binary
# parsers live in 20-parsers.cases.

[cmd_raw]
desc: `ipmitool raw` with no arguments
args: -I dummy raw
covers: raw

[cmd_raw_help]
desc: `ipmitool raw help`
args: -I dummy raw help
covers: raw

[cmd_i2c]
desc: `ipmitool i2c` with no arguments
args: -I dummy i2c
covers: i2c

[cmd_i2c_help]
desc: `ipmitool i2c help`
args: -I dummy i2c help
covers: i2c

