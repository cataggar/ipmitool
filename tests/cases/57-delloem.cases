# C oracle first: the transcript assertions include request bytes and ordering.
# The vFlash success case cannot be driven by the dummy CLI (vFlash requires
# the open/wmi interface) and needs a separate fake-interface test.
[delloem_help]
args: -I dummy delloem help
covers: delloem

[delloem_unknown]
args: -I dummy delloem bogus
covers: delloem

[delloem_lcd_help]
args: -I dummy delloem lcd help
covers: delloem

[delloem_lcd_info_10g]
args: -I dummy delloem lcd info
transcript: delloem_10g.tr
covers: delloem

