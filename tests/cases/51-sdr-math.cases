covers: sdr

[sd_math_get_pos_exp]
desc: `sdr get "Pos Exp"' - verbose single-sensor output
args: -I dummy sdr get "Pos Exp"
transcript: sd_math.tr
covers: sdr

[sd_math_get_ones_compl]
desc: `sdr get "Ones Compl"' - verbose single-sensor output
args: -I dummy sdr get "Ones Compl"
transcript: sd_math.tr
covers: sdr

[sd_math_get_twos_compl]
desc: `sdr get "Twos Compl"' - verbose single-sensor output
args: -I dummy sdr get "Twos Compl"
