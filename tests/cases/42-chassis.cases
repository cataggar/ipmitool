# Depth coverage for lib/ipmi_chassis.c - the `chassis` command tree and the
# `power` shortcut.
#
# 30-commands.cases already exercises `chassis status`, `chassis power status`,
# `chassis policy list`, `chassis bootparam get 5` and `chassis selftest`
# against tests/transcripts/bmc.tr, and 10-commands.cases covers the bare and
# `help` invocations.  What follows walks every subcommand, every argument
# parsing branch, every decode branch of Get Chassis Status / Get Self Test
# Results / Get POH Counter / Get System Restart Cause / all eight Get System
# Boot Options parameters, and every error path.
#
# Where a value could plausibly be produced by more than one implementation -
# a completion code, a bit position, a byte offset, a boot device selector -
# the transcripts use values that disagree between the candidates rather than
# values that happen to coincide.

# --- top level dispatch ---------------------------------------------------

[chassis_invalid_subcommand]
desc: an unrecognized chassis subcommand
args: -I dummy chassis bogus
covers: chassis

# --- chassis status -------------------------------------------------------

[chassis_status_all_bits]
desc: Get Chassis Status with every decoded bit set and restore policy 3
args: -I dummy chassis status
transcript: chassis_status_full.tr
covers: chassis

[chassis_status_no_optional]
desc: Get Chassis Status without the optional front panel byte
args: -I dummy chassis status
transcript: chassis_status_short.tr
covers: chassis

[chassis_status_policy_previous]
desc: restore policy 1 and a front panel byte of zero
args: -I dummy chassis status
transcript: chassis_status_prev.tr
covers: chassis

[chassis_status_power_off]
desc: power off, restore policy 2, one last-power-event bit, one fault bit
args: -I dummy chassis status
transcript: chassis_status_off.tr
covers: chassis

[chassis_status_ccode]
desc: Get Chassis Status rejected by the BMC
args: -I dummy chassis status
transcript: chassis_ccode.tr
covers: chassis

