# Each option clears its own mask before OR-ing its value in.  With a single
# option the flags byte is still zero, so the clear is invisible; these pairs
# set another bit in the same byte first, which makes every mask observable.

[chassis_bootdev_opt_verb_no_yes]
desc: verbose=yes must clear the quiet bits verbose=no set
args: -I dummy chassis bootdev pxe options=verbose=no,verbose=yes
transcript: chassis.tr
covers: chassis

[chassis_bootdev_opt_verb_yes_no]
desc: verbose=no must clear the verbose bits verbose=yes set
args: -I dummy chassis bootdev pxe options=verbose=yes,verbose=no
transcript: chassis.tr
covers: chassis

[chassis_bootdev_opt_cons_skip_en]
desc: cons_redirect=enable must clear the skip bits
args: -I dummy chassis bootdev pxe options=cons_redirect=skip,cons_redirect=enable
transcript: chassis.tr
covers: chassis

[chassis_bootdev_opt_cons_en_skip]
desc: cons_redirect=skip must clear the enable bits
args: -I dummy chassis bootdev pxe options=cons_redirect=enable,cons_redirect=skip
transcript: chassis.tr
covers: chassis

[chassis_bootdev_opt_bf1_valid_last]
desc: byte 1 options with valid applied last
args: -I dummy chassis bootdev pxe options=persistent,efiboot,valid
transcript: chassis.tr
covers: chassis

[chassis_bootdev_opt_bf1_persist_last]
desc: byte 1 options with persistent applied last
args: -I dummy chassis bootdev pxe options=valid,efiboot,persistent
transcript: chassis.tr
covers: chassis

[chassis_bootdev_opt_bf1_efi_last]
desc: byte 1 options with efiboot applied last
args: -I dummy chassis bootdev pxe options=valid,persistent,efiboot
transcript: chassis.tr
covers: chassis

[chassis_bootdev_opt_bf2_cmos_last]
desc: byte 2 options with clear-cmos applied last
args: -I dummy chassis bootdev pxe options=lockkbd,screenblank,lockoutreset,clear-cmos
transcript: chassis.tr
covers: chassis

[chassis_bootdev_opt_bf2_kbd_last]
desc: byte 2 options with lockkbd applied last
args: -I dummy chassis bootdev pxe options=clear-cmos,screenblank,lockoutreset,lockkbd
transcript: chassis.tr
covers: chassis

[chassis_bootdev_opt_bf2_blank_last]
desc: byte 2 options with screenblank applied last
args: -I dummy chassis bootdev pxe options=clear-cmos,lockkbd,lockoutreset,screenblank
transcript: chassis.tr
covers: chassis

[chassis_bootdev_opt_bf2_reset_last]
desc: byte 2 options with lockoutreset applied last
args: -I dummy chassis bootdev pxe options=clear-cmos,lockkbd,screenblank,lockoutreset
transcript: chassis.tr
covers: chassis

[chassis_bootdev_opt_bf3_power_last]
desc: byte 3 options with lockout_power applied last
args: -I dummy chassis bootdev pxe options=force_pet,upw_bypass,lockout_sleep,lockout_power
transcript: chassis.tr
covers: chassis

[chassis_bootdev_opt_bf3_pet_last]
desc: byte 3 options with force_pet applied last
args: -I dummy chassis bootdev pxe options=lockout_power,upw_bypass,lockout_sleep,force_pet
transcript: chassis.tr
covers: chassis

[chassis_bootdev_opt_bf3_upw_last]
desc: byte 3 options with upw_bypass applied last
args: -I dummy chassis bootdev pxe options=lockout_power,force_pet,lockout_sleep,upw_bypass
transcript: chassis.tr
covers: chassis

[chassis_bootdev_opt_bf3_sleep_last]
desc: byte 3 options with lockout_sleep applied last
args: -I dummy chassis bootdev pxe options=lockout_power,force_pet,upw_bypass,lockout_sleep
transcript: chassis.tr
covers: chassis

[chassis_bootdev_opt_bf3_vdflt_last]
desc: byte 3 options with verbose=default applied last over a set field
args: -I dummy chassis bootdev pxe options=lockout_power,verbose=no,verbose=default
transcript: chassis.tr
covers: chassis

[chassis_bootdev_opt_many]
