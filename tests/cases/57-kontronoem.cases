# Recorded from the C implementation before selecting the Zig port.
# Request logs pin the OEM LUN and payload as well as the FRU helper calls.

[kontron_nextboot_bios]
args: -I dummy kontronoem nextboot BIOS
transcript: kontron_nextboot.tr
covers: kontronoem

