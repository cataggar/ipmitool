transcript: mc.tr
covers: mc

[mc_watchdog_set_timeout_min]
desc: the lowest accepted timeout
args: -I dummy mc watchdog set timeout=1
transcript: mc.tr
covers: mc

[mc_watchdog_set_timeout_zero]
desc: one below the lowest accepted timeout
args: -I dummy mc watchdog set timeout=0
transcript: mc.tr
covers: mc

[mc_watchdog_set_timeout_max]
desc: the highest accepted timeout
args: -I dummy mc watchdog set timeout=6553
transcript: mc.tr
covers: mc

[mc_watchdog_set_timeout_over]
desc: one above the highest accepted timeout
args: -I dummy mc watchdog set timeout=6554
transcript: mc.tr
covers: mc

[mc_watchdog_set_pretimeout_min]
desc: the lowest accepted pre-timeout
args: -I dummy mc watchdog set pretimeout=1
transcript: mc.tr
covers: mc

[mc_watchdog_set_pretimeout_zero]
desc: one below the lowest accepted pre-timeout
args: -I dummy mc watchdog set pretimeout=0
transcript: mc.tr
covers: mc

[mc_watchdog_set_pretimeout_max]
desc: the highest accepted pre-timeout
args: -I dummy mc watchdog set pretimeout=255
transcript: mc.tr
covers: mc

[mc_watchdog_set_pretimeout_over]
desc: one above the highest accepted pre-timeout
args: -I dummy mc watchdog set pretimeout=256
transcript: mc.tr
covers: mc

[mc_watchdog_set_every_option]
desc: every option at once, which pins each shift and mask in the request payload
args: -I dummy mc watchdog set use=sms action=reset int=msg timeout=100 pretimeout=20 clear=frb2 clear=oem nolog dontstop
transcript: mc.tr
covers: mc

[mc_watchdog_set_first_letter_only]
desc: options are dispatched on their first letter alone
args: -I dummy mc watchdog set t=5 p=1 u=post a=cycle i=nmi n d
transcript: mc.tr
covers: mc

[mc_watchdog_set_use_none]
desc: the "none" entries of each table map to zero
args: -I dummy mc watchdog set use=none int=none action=none
transcript: mc.tr
covers: mc

[mc_watchdog_set_use_oem]
desc: the last named entry of the timer use table
args: -I dummy mc watchdog set use=oem
transcript: mc.tr
covers: mc

[mc_watchdog_set_int_smi]
desc: pre-timeout interrupt SMI, which lands in the high nibble of byte 1
args: -I dummy mc watchdog set int=smi
transcript: mc.tr
covers: mc

[mc_watchdog_set_action_poweroff]
desc: action power down, which lands in the low nibble of byte 1
args: -I dummy mc watchdog set action=poweroff
transcript: mc.tr
covers: mc

[mc_watchdog_set_clear_multiple]
desc: clear can be repeated and the bits accumulate
args: -I dummy mc watchdog set clear=post clear=osload clear=sms
transcript: mc.tr
covers: mc

[mc_watchdog_set_clear_none]
desc: clear=none sets bit 0 of the clear mask
args: -I dummy mc watchdog set clear=none
transcript: mc.tr
covers: mc

[mc_watchdog_set_invalid_option]
desc: an unknown option is rejected without sending a watchdog write
args: -I dummy mc watchdog set zzz=1
transcript: mc.tr
covers: mc

[mc_watchdog_set_verbose]
desc: -v prints the assembled payload and every decoded field
args: -I dummy -v mc watchdog set use=oem action=cycle int=nmi timeout=99 pretimeout=7 clear=sms nolog dontstop
transcript: mc.tr
covers: mc

[mc_watchdog_long_diagnostic]
desc: out-of-range timeout logs a long integer and the multi-line watchdog usage
args: -I dummy -v mc watchdog set timeout=6554
transcript: mc.tr
covers: mc

[mc_watchdog_set_ccode]
desc: Set Watchdog Timer rejected by the BMC
args: -I dummy mc watchdog set timeout=30
transcript: mc_ccode.tr
covers: mc

