# ---------------------------------------------------------------------------
# mc setenables
# ---------------------------------------------------------------------------

[mc_setenables_no_args]
desc: setenables with no options prints the mc usage and fails
args: -I dummy mc setenables
transcript: mc.tr
covers: mc

[mc_setenables_help]
desc: setenables help prints the mc usage and succeeds
args: -I dummy mc setenables help
transcript: mc.tr
covers: mc

[mc_setenables_on]
desc: the existing space-separated spelling enables a flag that is off
args: -I dummy mc setenables oem0 on
transcript: mc.tr
covers: mc

[mc_setenables_off]
desc: disabling a flag that is on sends Set BMC Global Enables with the new mask
args: -I dummy mc setenables system_event_log off
transcript: mc.tr
covers: mc

[mc_setenables_two_options]
desc: two options in one command, both applied to the same mask
args: -I dummy mc setenables recv_msg_intr off event_msg off
transcript: mc.tr
covers: mc

[mc_setenables_all_on]
desc: every flag enabled, which pins all seven mask constants at once
args: -I dummy mc setenables recv_msg_intr on event_msg_intr on event_msg on system_event_log on oem0 on oem1 on oem2 on
transcript: mc.tr
covers: mc

[mc_setenables_all_off]
desc: every flag disabled, the complement of mc_setenables_all_on
args: -I dummy mc setenables recv_msg_intr off event_msg_intr off event_msg off system_event_log off oem0 off oem1 off oem2 off
transcript: mc.tr
covers: mc

[mc_setenables_equals_form]
desc: the documented option=value form enables a flag and sends its new mask
args: -I dummy mc setenables oem0=on
transcript: mc.tr
covers: mc

[mc_setenables_unknown_name]
desc: an option name that is in no table entry is an error without a write
args: -I dummy mc setenables bogus on
transcript: mc.tr
covers: mc

[mc_setenables_bad_value]
desc: a known name followed by something other than on/off fails without a write
args: -I dummy mc setenables oem0 maybe
transcript: mc.tr
covers: mc

[mc_setenables_get_ccode]
desc: the initial Get BMC Global Enables fails
args: -I dummy mc setenables oem0 on
transcript: mc_ccode.tr
covers: mc

[mc_setenables_set_ccode]
desc: the Set BMC Global Enables fails after a successful get
args: -I dummy mc setenables oem0 on
transcript: mc_enables_setfail.tr
covers: mc

[mc_setenables_equals_off]
desc: the documented option=off form clears a set flag
args: -I dummy mc setenables system_event_log=off
transcript: mc.tr
covers: mc

[mc_setenables_mixed_forms]
desc: documented and legacy forms can be combined in the same command
args: -I dummy mc setenables system_event_log=off oem0 on
transcript: mc.tr
covers: mc

[mc_setenables_bare_name]
desc: a bare name at the end of argv must not read past its NUL
args: -I dummy mc setenables oem0
transcript: mc.tr
covers: mc

[mc_setenables_empty_value]
desc: an empty =value is rejected without a write
args: -I dummy mc setenables oem0=
transcript: mc.tr
covers: mc

[mc_setenables_prefix_name]
desc: an option name with a valid prefix is not an exact match
args: -I dummy mc setenables oem0extra=on
transcript: mc.tr
covers: mc

[mc_setenables_bad_after_good]
desc: do not write a partially updated mask if a later option is invalid
args: -I dummy mc setenables oem0=on system_event_log=maybe
transcript: mc.tr
covers: mc

