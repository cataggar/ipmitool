transcript: mc.tr
covers: mc

[mc_watchdog_set_pretimeout_empty]
desc: an empty pretimeout is not a valid value
args: -I dummy mc watchdog set pretimeout=
transcript: mc.tr
covers: mc

[mc_watchdog_set_use_empty]
desc: an empty use does not match reserved NULL table entries
args: -I dummy mc watchdog set use=
transcript: mc.tr
covers: mc

[mc_watchdog_set_int_empty]
desc: an empty int is not valid
args: -I dummy mc watchdog set int=
transcript: mc.tr
covers: mc

[mc_watchdog_set_action_empty]
desc: an empty action is not valid
args: -I dummy mc watchdog set action=
transcript: mc.tr
covers: mc

[mc_watchdog_set_clear_empty]
desc: an empty clear is not valid
args: -I dummy mc watchdog set clear=
transcript: mc.tr
covers: mc

[mc_watchdog_set_partial_number]
desc: a numeric prefix followed by junk cannot configure the timer
args: -I dummy mc watchdog set timeout=1sec
transcript: mc.tr
covers: mc

[mc_watchdog_set_flag_value]
desc: valueless flags cannot take an =value
args: -I dummy mc watchdog set nolog=on
transcript: mc.tr
covers: mc

[mc_watchdog_set_bad_after_good]
desc: an invalid option after a valid one must not write the partial settings
args: -I dummy mc watchdog set timeout=30 action=zzz
transcript: mc.tr
covers: mc

# ---------------------------------------------------------------------------
# Cases added after the mutation battery, each pinning one constant that the
# first 112 left indistinguishable from a plausible neighbour.
# ---------------------------------------------------------------------------

[mc_info_reserved_revision]
desc: the reserved bit 4 of Device Revision is masked off, bit 7 is not
args: -I dummy mc info
transcript: mc_devid_rsvd.tr
covers: mc

[mc_guid_auto_future_timestamp]
desc: autodetect rejects a version 1 GUID dated in the future and keeps looking
args: -I dummy mc guid
transcript: mc_guid_future.tr
covers: mc

[mc_watchdog_get_reserved_use_bit]
desc: bit 3 of the timer use byte is masked off before indexing wdt_use[]
args: -I dummy mc watchdog get
transcript: mc_wdt_rsvd_bit.tr
covers: mc

[mc_getsysinfo_length_fourteen]
desc: a declared length of 14 is exactly one block, not two
args: -I dummy mc getsysinfo system_name
transcript: mc_sysinfo_len14.tr
covers: mc

[mc_getsysinfo_length_254]
desc: an unsigned declared length of 254 reads 16 blocks without overrunning the output
args: -I dummy mc getsysinfo system_name
transcript: mc_sysinfo_long.tr
covers: mc

[mc_getsysinfo_length_255]
desc: an unsigned declared length of 255 reads 17 blocks and copies just one final byte
args: -I dummy mc getsysinfo system_fw_version
transcript: mc_sysinfo_long.tr
covers: mc

[mc_getsysinfo_verbose_once]
desc: a single -v is below the threshold for the param/block/set triple
args: -I dummy -v mc getsysinfo system_name
transcript: mc_sysinfo.tr
covers: mc

[mc_info_wide_fields]
desc: manufacturer/product/aux bytes all distinct and non-zero, so a wrong byte order or a dropped high byte shows
args: -I dummy mc info
transcript: mc_devid_wide.tr
covers: mc
