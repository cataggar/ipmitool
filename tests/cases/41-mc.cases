# Depth coverage for lib/ipmi_mc.c: the `mc' / `bmc' command tree.
#
# 30-commands.cases reaches `mc' once per breadth check. The cases here go one
# level deeper: every branch of ipmi_mc_main(), ipmi_mc_reset(),
# ipmi_mc_get_deviceid(), ipmi_mc_print_guid()/ipmi_parse_guid(),
# ipmi_mc_get_enables(), ipmi_mc_set_enables(), ipmi_mc_get_selftest(),
# ipmi_mc_get_watchdog(), parse_set_wdt_options(), ipmi_mc_set_watchdog(),
# ipmi_mc_shutoff_watchdog(), ipmi_mc_rst_watchdog() and ipmi_sysinfo_main().
#
# Wherever a length, count or bit mask is observable the fixtures are chosen so
# that the plausible alternatives *disagree*: the block count of a system info
# read, the exact request payload of `watchdog set' and `setenables', the
# expiration-flag bit numbering and the `data_len == sizeof(*devid)' test all
# have a case that changes if the constant changes. The long diagnostic
# snapshots the C oracle's signed `%ld` at error level and multiline usage.

# ---------------------------------------------------------------------------
# ipmi_mc_main() dispatch
# ---------------------------------------------------------------------------

[mc_unknown_command]
desc: an unrecognised first argument prints the mc usage and fails
args: -I dummy mc bogus
transcript: mc.tr
covers: mc

[bmc_unknown_command]
desc: the `bmc' alias reaches the same handler and the same message
args: -I dummy bmc bogus
transcript: mc.tr
covers: bmc

# ---------------------------------------------------------------------------
# mc reset
# ---------------------------------------------------------------------------

[mc_reset_no_args]
desc: mc reset without warm/cold prints the reset usage
args: -I dummy mc reset
transcript: mc.tr
covers: mc

[mc_reset_help]
desc: mc reset help prints the reset usage and succeeds
args: -I dummy mc reset help
transcript: mc.tr
covers: mc

[mc_reset_bogus]
desc: mc reset with an unknown mode names argv[0] in the error
args: -I dummy mc reset bogus
transcript: mc.tr
covers: mc

[bmc_reset_bogus]
desc: the same through the bmc alias, so argv[0] really is printed
args: -I dummy bmc reset bogus
transcript: mc.tr
covers: bmc

[mc_reset_cold]
desc: cold reset sends 06/02 and reports "cold"
args: -I dummy mc reset cold
transcript: mc.tr
covers: mc

[mc_reset_warm]
desc: warm reset sends 06/03 and reports "warm"
args: -I dummy mc reset warm
transcript: mc.tr
covers: mc

[mc_reset_cold_ccode]
desc: a completion code on cold reset is still an error
args: -I dummy mc reset cold
transcript: mc_ccode.tr
covers: mc

[mc_reset_warm_ccode]
desc: a completion code on warm reset is an error
args: -I dummy mc reset warm
transcript: mc_ccode.tr
covers: mc

