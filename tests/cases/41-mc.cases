args: -I dummy mc guid ipmi
transcript: mc.tr
covers: mc

[mc_guid_rfc]
desc: guid rfc forces RFC4122 network byte order; this GUID has version 6 there
args: -I dummy mc guid rfc
transcript: mc.tr
covers: mc

[mc_guid_smbios]
desc: guid smbios mixes little-endian time fields with a network-order node
args: -I dummy mc guid smbios
transcript: mc.tr
covers: mc

[mc_guid_dump]
desc: guid dump prints the raw bytes and reports an unknown version
args: -I dummy mc guid dump
transcript: mc.tr
covers: mc

[mc_guid_auto_explicit]
desc: guid auto is the default and prints the detected encoding
args: -I dummy mc guid auto
transcript: mc.tr
covers: mc

[mc_guid_rfc4122_spelling]
desc: the advertised rfc4122 spelling forces RFC4122 network byte order
args: -I dummy mc guid rfc4122
transcript: mc.tr
covers: mc

