covers: event

[event_spec_offset_0]
desc: memory correctable ECC, offset 0
args: -I dummy event MEMY "Correctable ECC"
transcript: event_sdr.tr
covers: event

[event_spec_offset_1]
desc: memory uncorrectable ECC, offset 1
args: -I dummy event MEMY "Uncorrectable ECC"
transcript: event_sdr.tr
covers: event

[event_spec_unknown]
desc: a description from a different sensor type
args: -I dummy event MEMY "Fully Redundant"
transcript: event_sdr.tr
covers: event

[event_spec_deassert]
desc: a sensor-specific event deasserted
args: -I dummy event MEMY "Correctable ECC" deassert
transcript: event_sdr.tr
covers: event

# --- fromsensor: an event/reading type with no case ------------------------

[event_other_type]
desc: event/reading type 0Dh falls through the switch and fails silently
args: -I dummy event OTHR list
transcript: event_sdr.tr
covers: event

[event_other_type_state]
desc: the same with a state, which is never looked at
args: -I dummy event OTHR present
transcript: event_sdr.tr
covers: event

# --- fromfile --------------------------------------------------------------

[event_file_missing]
desc: a file that does not exist
args: -I dummy event file {work}/nope.txt
transcript: bmc.tr
covers: event

[event_file_one]
desc: a single event line
args: -I dummy event file {work}/ev.txt
transcript: bmc.tr
text: ev.txt event/one.txt
covers: event

[event_file_comments]
desc: comments, blank lines and surrounding whitespace are all stripped
args: -I dummy event file {work}/ev.txt
transcript: bmc.tr
text: ev.txt event/comments.txt
covers: event

[event_file_short]
desc: a line with fewer than seven bytes is reported and skipped
args: -I dummy event file {work}/ev.txt
transcript: bmc.tr
text: ev.txt event/short.txt
covers: event

[event_file_bad_token]
desc: an unparsable token stops the line and reports it twice
args: -I dummy event file {work}/ev.txt
transcript: bmc.tr
text: ev.txt event/badtok.txt
covers: event

[event_file_bad_then_ok]
desc: a bad line does not stop the file, and the later line resets the status
args: -I dummy event file {work}/ev.txt
transcript: bmc.tr
text: ev.txt event/badtok_then_ok.txt
covers: event

[event_file_extra]
desc: tokens past the seventh are ignored
args: -I dummy event file {work}/ev.txt
transcript: bmc.tr
text: ev.txt event/extra.txt
covers: event

[event_file_multi]
desc: three events from one file
args: -I dummy event file {work}/ev.txt
transcript: bmc.tr
text: ev.txt event/multi.txt
covers: event

[event_file_deassert]
desc: the event direction bit comes from the file
args: -I dummy event file {work}/ev.txt
transcript: bmc.tr
text: ev.txt event/deassert.txt
covers: event

[event_file_empty]
desc: an empty file sends nothing and succeeds
args: -I dummy event file {work}/ev.txt
transcript: bmc.tr
text: ev.txt event/empty.txt
covers: event

[event_file_blank]
desc: a file of blank lines sends nothing and succeeds
args: -I dummy event file {work}/ev.txt
transcript: bmc.tr
text: ev.txt event/blank.txt
covers: event

[event_file_send_fail]
desc: a rejected event stops the file
args: -I dummy event file {work}/ev.txt
transcript: event_pem_fail.tr
text: ev.txt event/multi.txt
covers: event

[event_file_ch_unknown]
desc: an unknown channel stops the file on the first line
args: -I dummy event file {work}/ev.txt
transcript: event_ch_unknown.tr
text: ev.txt event/multi.txt
covers: event

[event_file_sysif]
desc: file events over the system interface carry the generator ID
args: -I dummy event file {work}/ev.txt
transcript: event_sysif.tr
text: ev.txt event/multi.txt
covers: event

[event_file_verbose]
desc: verbose file replay
args: -I dummy -v event file {work}/ev.txt
transcript: bmc.tr
text: ev.txt event/one.txt
covers: event

[event_st0_offset_guard]
desc: a zero sensor type short-circuits the offset lookup to 0
args: -I dummy event SZER "Drive Present"
transcript: event_sdr_st0.tr
covers: event

[event_file_fail_stops]
desc: a rejected event stops the file at that line
args: -I dummy event file {work}/ev.txt
transcript: event_pem_fail.tr
text: ev.txt event/multi.txt
covers: event

[event_file_kw_case]
desc: the file keyword is matched with strcmp, so FILE is a sensor name
args: -I dummy event FILE {work}/ev.txt
transcript: bmc.tr
text: ev.txt event/one.txt
covers: event

[event_file_long_line]
desc: a 1023-character line is read whole, so fgets gets the full buffer size
args: -I dummy event file {work}/ev.txt
transcript: bmc.tr
text: ev.txt event/longline.txt
covers: event

[event_file_tab_indent]
desc: leading whitespace is stripped before the line is tokenised
args: -I dummy event file {work}/ev.txt
transcript: bmc.tr
text: ev.txt event/tabtok.txt
covers: event
