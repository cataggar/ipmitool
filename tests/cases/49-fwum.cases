[fwum_download_wrong_magic]
args: -I dummy fwum download {work}/image.bin
blob: image.bin fwum/wrong_magic.hex
transcript: fwum_start_fail.tr
covers: fwum

[fwum_info_failure]
args: -I dummy fwum info
covers: fwum

[fwum_status_failure]
args: -I dummy fwum status
covers: fwum

[fwum_download_device_failure]
args: -I dummy fwum download {work}/image.bin
