desc: high-bit fields, hex padding and extension version 15.15
args: -I dummy picmg properties
transcript: picmg_properties_stdout_high.tr
covers: picmg

[picmg_properties_stdout_ccode]
desc: failed Get PICMG Properties yields no stdout
