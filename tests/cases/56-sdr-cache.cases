blob: cache.bin sdr/sd_cache_all.hex
covers: sensor

[sd_cache_sensor_get]
desc: sensor get reads the -S cache
args: -I dummy -S {work}/cache.bin sensor get "FAN1 Tach"
transcript: sd_cache.tr
blob: cache.bin sdr/sd_cache_all.hex
covers: sensor

