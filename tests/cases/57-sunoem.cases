# C-oracle snapshots for every Sun OEM public subcommand.  All transcripts use
# the dummy BMC; the associated snapshots preserve wire, stdout, stderr, exit.
[sunoem_usage]
args: -I dummy sunoem
covers: sunoem

[sunoem_help]
args: -I dummy sunoem help
covers: sunoem

[sunoem_unknown]
args: -I dummy sunoem bogus
covers: sunoem

[sunoem_version]
args: -I dummy sunoem version
transcript: sunoem_ok.tr
covers: sunoem

[sunoem_version_denied]
args: -I dummy sunoem version
transcript: sunoem_denied.tr
covers: sunoem

[sunoem_version_trunc]
