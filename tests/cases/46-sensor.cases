# --- sensors reached over a non-zero LUN and channel -----------------------
# tests/transcripts/sensor_bridge.tr owns record 0xa39c: owner 2Ch, LUN 1,
# channel 5.  These cases are what pins `keys.lun` (& 0x03) and `keys.channel`
# (>> 4 & 0x0f); every other sensor in the suite sits at LUN 0 / channel 0,
# where a wrong mask or a wrong shift is invisible.

[sen_bridged_list]
desc: sensor list for a sensor owned by a non-BMC controller on channel 5
args: -I dummy sensor list
transcript: sensor_bridge.tr
covers: sensor

[sen_bridged_list_verbose]
desc: verbose sensor list over a bridge; the LUN reaches the wire
args: -I dummy -v sensor list
transcript: sensor_bridge.tr
covers: sensor

[sen_bridged_get]
desc: sensor get over a bridge
args: -I dummy sensor get BrdgS
transcript: sensor_bridge.tr
covers: sensor

[sen_bridged_reading]
desc: sensor reading over a bridge
args: -I dummy sensor reading BrdgS
transcript: sensor_bridge.tr
covers: sensor

[sen_bridged_thresh_unr]
desc: single threshold set over a bridge; Set Sensor Thresholds carries LUN 1
args: -I dummy sensor thresh BrdgS unr 30
transcript: sensor_bridge.tr
covers: sensor

[sen_bridged_thresh_upper]
desc: bulk upper threshold set over a bridge
args: -I dummy sensor thresh BrdgS upper 18 24 30
transcript: sensor_bridge.tr
covers: sensor

[sen_bridged_thresh_clamp]
desc: lcr equal to a lower-non-recoverable threshold that converted negative
args: -I dummy sensor thresh BrdgS lcr 0
transcript: sensor_bridge.tr
covers: sensor

# --- threshold validation boundaries --------------------------------------
# TempA reads back lnc 15, lcr 10, lnr 5, unc 75, ucr 85, unr 95 raw; M is 2,
# so the validator compares against 30, 20, 10, 150, 170 and 190.  The `_ok'
# and `_bad' cases above sit either side of those numbers, which leaves every
# `<=' indistinguishable from `<' (and every `>=' from `>').  Each case below
# asks for a value exactly *equal* to one of the six converted thresholds, so
# the two candidate comparisons disagree.

[sen_thresh_unr_eq_ucr]
desc: unr exactly equal to ucr, where <= and < disagree
args: -I dummy sensor thresh TempA unr 170
transcript: sensor.tr
covers: sensor

[sen_thresh_unr_eq_unc]
desc: unr exactly equal to unc, reached with ucr already excluded
args: -I dummy sensor thresh TempA unr 150
transcript: sensor.tr
covers: sensor

[sen_thresh_ucr_eq_unr]
desc: ucr exactly equal to unr, where >= and > disagree
args: -I dummy sensor thresh TempA ucr 190
transcript: sensor.tr
covers: sensor

[sen_thresh_ucr_eq_unc]
desc: ucr exactly equal to unc, where <= and < disagree
args: -I dummy sensor thresh TempA ucr 150
transcript: sensor.tr
covers: sensor

[sen_thresh_unc_eq_unr]
desc: unc exactly equal to unr, where >= and > disagree
args: -I dummy sensor thresh TempA unc 190
transcript: sensor.tr
covers: sensor

[sen_thresh_unc_eq_ucr]
desc: unc exactly equal to ucr, where >= and > disagree
args: -I dummy sensor thresh TempA unc 170
transcript: sensor.tr
covers: sensor

[sen_thresh_unc_eq_lnc]
desc: unc exactly equal to lnc, where <= and < disagree
args: -I dummy sensor thresh TempA unc 30
transcript: sensor.tr
covers: sensor

[sen_thresh_lnc_eq_lcr]
desc: lnc exactly equal to lcr, where <= and < disagree
args: -I dummy sensor thresh TempA lnc 20
transcript: sensor.tr
covers: sensor

[sen_thresh_lnc_eq_lnr]
desc: lnc exactly equal to lnr, where <= and < disagree
args: -I dummy sensor thresh TempA lnc 10
transcript: sensor.tr
covers: sensor

[sen_thresh_lnc_eq_unc]
desc: lnc exactly equal to unc, where >= and > disagree
args: -I dummy sensor thresh TempA lnc 150
transcript: sensor.tr
covers: sensor

[sen_thresh_lcr_eq_lnc]
desc: lcr exactly equal to lnc, where >= and > disagree
args: -I dummy sensor thresh TempA lcr 30
transcript: sensor.tr
covers: sensor

[sen_thresh_lcr_eq_lnr]
desc: lcr exactly equal to lnr, where <= and < disagree
args: -I dummy sensor thresh TempA lcr 10
transcript: sensor.tr
covers: sensor

[sen_thresh_lnr_eq_lnc]
desc: lnr exactly equal to lnc, where >= and > disagree
args: -I dummy sensor thresh TempA lnr 30
transcript: sensor.tr
covers: sensor

[sen_thresh_lnr_eq_lcr]
desc: lnr exactly equal to lcr, where >= and > disagree
args: -I dummy sensor thresh TempA lnr 20
transcript: sensor.tr
covers: sensor

# --- validation against a BMC whose thresholds are out of order -----------
# tests/transcripts/sensor_disorder.tr reports unc > ucr, unr < ucr, lnr > lcr
# and lnc < lcr.  Only such a readback can make the second and third clauses of
# ipmi_sensor_set_threshold()'s validation chain the deciding ones; against a
# well-ordered BMC the first clause always fires first and the rest are dead.

[sen_disord_unr_eq_unc]
desc: unr above ucr but exactly equal to unc, so the second clause decides
args: -I dummy sensor thresh Disord unr 165
transcript: sensor_disorder.tr
covers: sensor

[sen_disord_unc_eq_unr]
desc: unc exactly equal to unr with ucr above both, so the first clause decides
args: -I dummy sensor thresh Disord unc 99
transcript: sensor_disorder.tr
covers: sensor

[sen_disord_lnc_eq_lnr]
desc: lnc above lcr but exactly equal to lnr, so the second clause decides
args: -I dummy sensor thresh Disord lnc 39
transcript: sensor_disorder.tr
covers: sensor

[sen_disord_lnr_eq_lnc]
desc: lnr exactly equal to lnc with lcr above both, so the first clause decides
args: -I dummy sensor thresh Disord lnr 13
transcript: sensor_disorder.tr
covers: sensor

[sen_disord_list]
desc: sensor list against a BMC whose thresholds are out of order
args: -I dummy sensor list
transcript: sensor_disorder.tr
covers: sensor

[sen_disord_get]
desc: sensor get against a BMC whose thresholds are out of order
args: -I dummy sensor get Disord
transcript: sensor_disorder.tr
covers: sensor

# --- validation against partial readable-threshold masks -------------------
# tests/transcripts/sensor_mask.tr reports mask 2Ah for MaskA and its
# complement 15h for MaskB, with the same six threshold values (lnc 30, lcr 20,
# lnr 10, unc 80, ucr 90, unr 100).  Each requested value is chosen so that the
# answer flips if any single `data[0] & bit' guard, or any mask inside one of
# those guards, is changed: a guard that is meant to be clear is asked for a
# value that the enabled clause would reject, and vice versa.

[sen_mask_a_unr_valid]
desc: unr above unc where ucr is not readable, so the ucr clause cannot fire
args: -I dummy sensor thresh MaskA unr 85
transcript: sensor_mask.tr
covers: sensor

[sen_mask_a_unr_invalid]
desc: unr below unc where only the unc clause is live
args: -I dummy sensor thresh MaskA unr 70
transcript: sensor_mask.tr
covers: sensor

[sen_mask_a_ucr_unreadable]
desc: ucr not readable at all, so no validation happens
args: -I dummy sensor thresh MaskA ucr 50
transcript: sensor_mask.tr
covers: sensor

[sen_mask_a_unc_invalid]
desc: unc at or above a readable unr
args: -I dummy sensor thresh MaskA unc 105
transcript: sensor_mask.tr
covers: sensor

[sen_mask_a_unc_valid]
desc: unc above ucr but ucr is not readable, so only the unr clause is live
args: -I dummy sensor thresh MaskA unc 95
transcript: sensor_mask.tr
covers: sensor

[sen_mask_a_lnc_unreadable]
desc: lnc not readable, so a value below lcr is accepted
args: -I dummy sensor thresh MaskA lnc 5
transcript: sensor_mask.tr
covers: sensor

[sen_mask_a_lcr_no_clauses]
desc: lcr readable but neither lnc nor lnr is, so nothing can reject it
args: -I dummy sensor thresh MaskA lcr 35
transcript: sensor_mask.tr
covers: sensor

[sen_mask_a_lnr_unreadable]
desc: lnr not readable, so a value above lcr is accepted
args: -I dummy sensor thresh MaskA lnr 15
transcript: sensor_mask.tr
covers: sensor

[sen_mask_b_unr_unreadable]
desc: unr not readable, so a value below ucr is accepted
