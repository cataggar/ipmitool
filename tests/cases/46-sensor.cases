# lib/ipmi_sensor.c: every subcommand, output mode and error path.
#
# The 20-parsers.cases file already has two `sensor' cases, but they only walk
# the happy path of one repository. These cases enumerate the module instead:
# each dispatch arm of ipmi_sensor_main(), each of the three output modes
# (plain, -c, -v) crossed with each record shape, every threshold validation
# branch, and the malformed-input behaviour that a port must reproduce.
#
# The fixtures deliberately use distinct, non-zero bytes for every multi-byte
# quantity (record IDs, the SDR reservation, the Get Sensor Reading Factors
# M/B fields, the six Get Sensor Thresholds values) so that a wrong offset,
# a wrong width or a wrong byte order changes the recorded output or the
# recorded request bytes. See tests/transport/Bmc.zig for the rule.

# --- dispatch --------------------------------------------------------------

[sen_no_args]
desc: bare `sensor' with no subcommand falls through to list
args: -I dummy sensor
transcript: sensor.tr
covers: sensor

[sen_help_sub]
desc: `sensor help' prints the one-line command summary
args: -I dummy sensor help
transcript: sensor.tr
covers: sensor

[sen_bad_subcommand]
desc: unknown sensor subcommand is rejected with exit 1
args: -I dummy sensor bogus
transcript: sensor.tr
covers: sensor

