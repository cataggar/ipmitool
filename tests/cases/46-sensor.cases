# MaskC's 0Bh has lnc set with lnr clear and unc set with unr clear, which no
# complementary pair of masks can express.  Each case below asks for a value
# that the *other* bit of the pair would judge differently.

[sen_mask_c_lnr_unreadable]
desc: lnr not readable while lnc is, so nothing rejects a value above lcr
args: -I dummy sensor thresh MaskC lnr 25
transcript: sensor_mask.tr
covers: sensor

[sen_mask_c_unr_unreadable]
desc: unr not readable while unc is, so nothing rejects a value below unc
args: -I dummy sensor thresh MaskC unr 75
transcript: sensor_mask.tr
covers: sensor

[sen_mask_c_lnc_invalid]
desc: lnc at or below a readable lcr
args: -I dummy sensor thresh MaskC lnc 15
transcript: sensor_mask.tr
covers: sensor

[sen_mask_c_unc_invalid]
desc: unc at or below a readable lnc
args: -I dummy sensor thresh MaskC unc 25
transcript: sensor_mask.tr
covers: sensor

[sen_mask_c_ucr_unreadable]
desc: ucr not readable while lcr is, so nothing rejects the value
args: -I dummy sensor thresh MaskC ucr 15
transcript: sensor_mask.tr
covers: sensor

[sen_mask_c_lcr_invalid]
desc: lcr at or above a readable lnc
args: -I dummy sensor thresh MaskC lcr 35
transcript: sensor_mask.tr
covers: sensor

# MaskD's 0Dh is the only mask in the suite where upper non-critical differs
# from lower critical and lower non-recoverable differs from upper critical.

[sen_mask_d_unc_invalid]
desc: unc at or below a readable lnc while lcr is unreadable
args: -I dummy sensor thresh MaskD unc 25
transcript: sensor_mask.tr
covers: sensor

[sen_mask_d_lcr_unreadable]
desc: lcr unreadable while unc is readable
args: -I dummy sensor thresh MaskD lcr 35
transcript: sensor_mask.tr
covers: sensor

[sen_mask_d_lnr_invalid]
desc: lnr at or above a readable lnc while ucr is unreadable
args: -I dummy sensor thresh MaskD lnr 35
transcript: sensor_mask.tr
covers: sensor

[sen_mask_d_ucr_unreadable]
desc: ucr unreadable while lnr is readable
args: -I dummy sensor thresh MaskD ucr 25
transcript: sensor_mask.tr
covers: sensor

[sen_mask_d_unr_unreadable]
desc: unr unreadable while unc is readable
args: -I dummy sensor thresh MaskD unr 25
transcript: sensor_mask.tr
covers: sensor

[sen_mask_d_lnc_invalid]
desc: lnc at or below a readable lnr while lcr is unreadable
args: -I dummy sensor thresh MaskD lnc 5
transcript: sensor_mask.tr
covers: sensor

# --- one-clause-at-a-time validation ---------------------------------------
# tests/transcripts/sensor_clause.tr reports readable-threshold masks with only
# a branch guard and (for the Clx* records) one clause bit set, so exactly one
# clause of ipmi_sensor_set_threshold()'s validation chain can decide the
# answer.  Each clause gets two settings: one exactly on its boundary and one a
# single degree past it, which is what separates the clause's val[] index from
# the other five thresholds in both directions.  30/20/10/80/90/100 are the
# converted lnc/lcr/lnr/unc/ucr/unr.

[sen_cls30_unr_eq_ucr]
desc: unr set to the readable ucr: rejected by the only live clause
args: -I dummy sensor thresh Clx30 unr 90
transcript: sensor_clause.tr
covers: sensor

[sen_cls30_unr_over_ucr]
desc: unr one degree above ucr: accepted
args: -I dummy sensor thresh Clx30 unr 91
transcript: sensor_clause.tr
covers: sensor

[sen_cls30_ucr_eq_unr]
