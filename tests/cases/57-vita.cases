# `-v` exposes discovery's LOG_INFO branches and IPMB acquisition's LOG_ERR
# diagnostics, in addition to checking their on-the-wire request lengths.
[vita_probe_ccode]
args: -v -I dummy vita help
transcript: vita_probe_ccode.tr
covers: vita

