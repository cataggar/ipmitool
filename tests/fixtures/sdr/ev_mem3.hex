# SDR Type 03h - Event-Only Sensor Record, generated for issue #11.
# Same sensor type as ev_mem0 but sensor number 3, so the CPU/DIMM clause must not fire.

11 00        # [1:2]  Record ID = 0x0011
51           # [3]    SDR version 1.5
03           # [4]    Record type 03h = Event-Only Record
15           # [5]    Record length = 21 bytes follow

20           # [6]    Sensor owner ID
00           # [7]    Owner LUN 0, channel 0
03           # [8]    Sensor number
20           # [9]    Entity ID
02           # [10]   Entity instance
0c           # [11]   Sensor type
6f           # [12]   Event/reading type
00 00        # [13:14] Sensor record sharing
00           # [15]   Reserved
00           # [16]   OEM
c9           # [17]   ID string type/length: 8-bit ASCII, 9 chars
4d 45 4d 20 53 4c 4f 54 33   # [18:26] "MEM SLOT3"
