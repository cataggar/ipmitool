# Full Sensor Record for the conversion battery.
# M = B = 511: the most positive 10-bit value, 0x1ff

11 11                        # Record ID = 0x1111
51                           # SDR version 0x51
01                           # Record type 0x01
32                           # Record length = 50 bytes follow
20                           # Sensor owner ID 0x20
00                           # Owner LUN / channel 0x00
51                           # Sensor number 81
03                           # Entity ID 0x03
51                           # Entity instance 0x51
7f                           # Sensor initialization 0x7f
68                           # Sensor capabilities 0x68
01                           # Sensor type 0x01
01                           # Event/reading type 0x01
ff 3f ff 3f 3f 3f            # Event mask / threshold masks
00                           # Units 1: analog=0 rate=0 mod=0 pct=0
04                           # Units 2: base unit 0x04
00                           # Units 3: modifier unit 0x00
00                           # Linearization 0x00
ff 6a                        # M = 511, tolerance = 42
ff 6b a9 de                  # B = 511, acc = 683, accexp = 2, dir = 1, Rexp = -3, Bexp = -2
07                           # Analog flags 0x07
33                           # Nominal reading 51
66                           # Normal maximum 102
11                           # Normal minimum 17
f0                           # Sensor maximum reading 240
03                           # Sensor minimum reading 3
e1                           # Upper non-recoverable 225
d2                           # Upper critical 210
c3                           # Upper non-critical 195
14                           # Lower non-recoverable 20
25                           # Lower critical 37
36                           # Lower non-critical 54
1b                           # Positive-going hysteresis 27
2c                           # Negative-going hysteresis 44
00 00                        # Reserved
00                           # OEM 0x00
c7                           # ID string type/length 0xc7
4d 61 78 20 4d 20 42         # ID string 'Max M B'
