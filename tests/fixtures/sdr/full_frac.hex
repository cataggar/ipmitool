# SDR Type 01h - Full Sensor Record with a non-integer conversion and a
# compound unit string.
#
# lib/ipmi_sel.c prints threshold event readings with `%.*f' where the
# precision is 0 when the value is a whole number and 2 otherwise, and appends
# ipmi_sdr_get_unit_string(unit.pct, unit.modifier, unit.type.base,
# unit.type.modifier).  full_temp.hex has M=1, both exponents zero and a plain
# `degrees C' unit, so it exercises neither.  Here M=3 and R exponent = -1, so
# a raw reading of 85 converts to 25.5, and the three unit fields are all
# distinct and non-zero.

05 00        # [1:2]  Record ID = 0x0005
51           # [3]    SDR version 1.5 (51h)
01           # [4]    Record type 01h = Full Sensor Record
34           # [5]    Record length = 52 bytes follow

20           # [6]    Sensor owner ID (BMC, slave address 20h)
00           # [7]    Owner LUN 0, channel 0
2d           # [8]    Sensor number 2Dh
03           # [9]    Entity ID 3 = Processor
01           # [10]   Entity instance 1
7f           # [11]   Sensor initialization
68           # [12]   Sensor capabilities
01           # [13]   Sensor type 01h = Temperature
01           # [14]   Event/reading type 01h = threshold
ff 3f        # [15:16] Assertion event mask / lower threshold reading mask
ff 3f        # [17:18] Deassertion event mask / upper threshold reading mask
3f 3f        # [19:20] Settable / readable threshold mask (all six thresholds)
05           # [21]   Units 1: percentage=1, modifier action=2 (basic/modifier)
04           # [22]   Units 2: base unit 04h = Volts
06           # [23]   Units 3: modifier unit 06h = Amps
00           # [24]   Linearization: linear
03           # [25]   M = 3 (LS 8 bits)
00           # [26]   M MS 2 bits | tolerance
00           # [27]   B = 0 (LS 8 bits)
00           # [28]   B MS 2 bits | accuracy LS 6 bits
00           # [29]   Accuracy MS | accuracy exp | sensor direction
f0           # [30]   R exponent = -1, B exponent = 0
07           # [31]   Analog flags: nominal, normal max and normal min specified
28           # [32]   Nominal reading = 40
50           # [33]   Normal maximum = 80
0a           # [34]   Normal minimum = 10
ff           # [35]   Sensor maximum reading = 255
00           # [36]   Sensor minimum reading = 0
5f           # [37]   Upper non-recoverable = 95
55           # [38]   Upper critical = 85
4b           # [39]   Upper non-critical = 75
05           # [40]   Lower non-recoverable = 5
0a           # [41]   Lower critical = 10
0f           # [42]   Lower non-critical = 15
02           # [43]   Positive-going threshold hysteresis
02           # [44]   Negative-going threshold hysteresis
00 00        # [45:46] Reserved
00           # [47]   OEM
c9           # [48]   ID string type/length: 8-bit ASCII, 9 characters
56 43 4f 52 45 20 33 56 33   # [49:57] "VCORE 3V3"
