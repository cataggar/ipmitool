# SDR Type 01h - Full Sensor Record used only with tests/transcripts/
# sensor_disorder.tr, where the BMC reports thresholds that are *not* in
# ascending order.
#
# ipmi_sensor_set_threshold() validates a requested threshold against its
# neighbours with a chain of two- and three-clause conditions.  When the BMC's
# readback is well ordered (as every other transcript's is) the *first* clause
# of each chain always decides, so the second and third clauses are dead and a
# mutation of them is invisible.  A deliberately disordered readback -- unc >
# ucr, unr < ucr, lnr > lcr, lnc < lcr -- makes the later clauses the deciding
# ones.  This is also the sort of thing a malicious or broken BMC can return.
#
# M is 1, B is 0 and both exponents are 0, so the converted value of every
# threshold equals its raw byte; that keeps the arithmetic out of the way of
# what these cases are for.

7e b4        # [1:2]  Record ID = 0xb47e
51           # [3]    SDR version 1.5 (51h)
01           # [4]    Record type 01h = Full Sensor Record
31           # [5]    Record length = 49 bytes follow

20           # [6]    Sensor owner ID (BMC)
00           # [7]    Owner LUN 0, channel 0
99           # [8]    Sensor number 99h
0f           # [9]    Entity ID 15 = Other Chassis Board
0c           # [10]   Entity instance 12
7f           # [11]   Sensor initialization
68           # [12]   Sensor capabilities: thresholds readable+settable
01           # [13]   Sensor type 01h = Temperature
01           # [14]   Event/reading type 01h = threshold
ff 3f        # [15:16] Assertion event mask / lower threshold reading mask
ff 3f        # [17:18] Deassertion event mask / upper threshold reading mask
3f 3f        # [19:20] Settable / readable threshold mask (all six thresholds)
00           # [21]   Units 1: analog format 0 (unsigned)
01           # [22]   Units 2: base unit 01h = degrees C
00           # [23]   Units 3: no modifier unit
00           # [24]   Linearization: linear
01           # [25]   M = 1 (LS 8 bits)
07           # [26]   M MS 2 bits = 0, tolerance = 7
00           # [27]   B = 0 (LS 8 bits)
00           # [28]   B MS 2 bits | accuracy LS 6 bits
00           # [29]   Accuracy MS | accuracy exp | sensor direction
00           # [30]   R exponent | B exponent (both 0)
07           # [31]   Analog flags: nominal, normal max and normal min specified
32           # [32]   Nominal reading = 50
5a           # [33]   Normal maximum = 90
14           # [34]   Normal minimum = 20
ff           # [35]   Sensor maximum reading = 255
00           # [36]   Sensor minimum reading = 0
63           # [37]   Upper non-recoverable = 99
7c           # [38]   Upper critical = 124
a5           # [39]   Upper non-critical = 165
27           # [40]   Lower non-recoverable = 39
1b           # [41]   Lower critical = 27
0d           # [42]   Lower non-critical = 13
05           # [43]   Positive-going threshold hysteresis
08           # [44]   Negative-going threshold hysteresis (differs from positive)
00 00        # [45:46] Reserved
00           # [47]   OEM
c6           # [48]   ID string type/length: 8-bit ASCII, 6 characters
44 69 73 6f 72 64  # [49:54] "Disord"
